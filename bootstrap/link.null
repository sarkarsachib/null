// bootstrap/link.null
// Link step for the self-hosted compiler.
//
// The language has no module system yet, so this program assembles
// bootstrap/nullc.null from the stage libraries: every top-level `fn` block from
// each part, once, followed by the driver below. The stage files stay canonical;
// nullc.null is generated from them and checked in so it can be read and diffed.
//
// Usage: env PYTHONPATH=src venv/bin/python bench/stage_runner.py bootstrap/link.null

fn starts_with(text: Text, prefix: Text) -> Bool {
    if LEN(text) < LEN(prefix) {
        return false;
    }
    let ok = true;
    let i = 0;
    while i < LEN(prefix) {
        if CHAR_AT(text, i) != CHAR_AT(prefix, i) {
            ok = false;
        }
        i = i + 1;
    }
    return ok;
}

fn fn_name(line: Text) -> Text {
    // "fn name(args) -> Type {" -> "name"
    let rest = SUBSTR(line, 3, LEN(line));
    let name = "";
    let i = 0;
    while i < LEN(rest) {
        let ch = CHAR_AT(rest, i);
        if ch == "(" {
            break;
        }
        if ch != " " {
            name = name + ch;
        }
        i = i + 1;
    }
    return name;
}

fn has_name(names, name: Text) -> Bool {
    let found = false;
    let i = 0;
    while i < LEN(names) {
        if names[i] == name {
            found = true;
        }
        i = i + 1;
    }
    return found;
}

// Copy every top-level function block of `path` into `out`, skipping names that
// are already present. A top-level block starts at `fn ` and ends at the first
// column-0 `}`; nested braces are indented, so no brace counting is needed.
fn gather(path: Text, out, names) {
    let lines = SPLIT(READ_FILE(path), "\n");
    let i = 0;
    while i < LEN(lines) {
        let line = lines[i];
        if starts_with(line, "fn ") {
            let name = fn_name(line);
            let block = [line];
            i = i + 1;
            while i < LEN(lines) {
                block = APPEND(block, lines[i]);
                if lines[i] == "}" {
                    break;
                }
                i = i + 1;
            }
            i = i + 1;
            if has_name(names, name) == false {
                names = APPEND(names, name);
                let b = 0;
                while b < LEN(block) {
                    out = APPEND(out, block[b]);
                    b = b + 1;
                }
                out = APPEND(out, "");
            } else {
                println("LINK skip duplicate " + name);
            }
        } else {
            i = i + 1;
        }
    }
    return [out, names];
}

let out = [
    "// ---------------------------------------------------------------------------",
    "// GENERATED by bootstrap/link.null - do not edit.",
    "// Sources: bootstrap/emitter.null (lexer, parser, emitter) and",
    "// bootstrap/vm.null (super-bit IR interpreter), plus the driver at the bottom.",
    "// One Null program: source -> AST -> IR -> execution, no host compiler in the loop.",
    "// ---------------------------------------------------------------------------",
    "",
];
let names = [];
let parts = ["bootstrap/emitter.null", "bootstrap/vm.null"];
let p = 0;
while p < LEN(parts) {
    let got = gather(parts[p], out, names);
    out = got[0];
    names = got[1];
    p = p + 1;
}

out = APPEND(out, "// --- driver: compile a source file and run it in this process ---");
out = APPEND(out, "//");
out = APPEND(out, "// argv[1] is the source path (default bootstrap/input.null), argv[2] is the IR");
out = APPEND(out, "// output path (default bootstrap/program.ir). bootstrap/compile-only.flag in");
out = APPEND(out, "// the working directory stops execution after emission; that is how nullc");
out = APPEND(out, "// compiles nullc (no infinite self-run).");
out = APPEND(out, "let source_path = \"bootstrap/input.null\";");
out = APPEND(out, "if ARGC() > 1 {");
out = APPEND(out, "    source_path = ARGV(1);");
out = APPEND(out, "}");
out = APPEND(out, "let ir_path = \"bootstrap/program.ir\";");
out = APPEND(out, "if ARGC() > 2 {");
out = APPEND(out, "    ir_path = ARGV(2);");
out = APPEND(out, "}");
out = APPEND(out, "let source = READ_FILE(source_path);");
out = APPEND(out, "let ir = compile_to_ir_text(source);");
out = APPEND(out, "WRITE_FILE(ir_path, ir);");
out = APPEND(out, "if FILE_EXISTS(\"bootstrap/compile-only.flag\") == false {");
out = APPEND(out, "    run(parse_rows(ir));");
out = APPEND(out, "}");

WRITE_FILE("bootstrap/nullc.null", JOIN(out, "\n"));
println("LINKED " + TO_STRING(LEN(names)) + " functions -> bootstrap/nullc.null");
