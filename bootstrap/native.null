// ---------------------------------------------------------------------------
// Stage 5: the native backend (Null side).
//
// Reads the TSV super-bit stream written by bootstrap/emitter.null and lowers
// it to x86-64 (System V, GNU as, Intel syntax).  The result is assembled and
// linked by the benchmark harness with `cc`.
//
// Design:
//   * no dispatch loop - every IR token becomes a fixed instruction sequence,
//     so there is no per-instruction opcode fetch/decode/switch;
//   * values live in frame slots addressed at compile time; there is no runtime
//     name lookup, no map, no boxing;
//   * variables get fixed frame offsets in a pre-pass (load/store are a single
//     mov), and functions are real `call`/`ret` with the SysV register ABI;
//   * specialised opcodes lower to their typed form: FAST_INDEX drops the
//     bounds check, FAST_LEN reads the array header, SIMD_ADD/SIMD_MUL run an
//     AVX2 loop with a scalar tail, FUSED_COMPREHEND becomes one fused loop
//     with a single output allocation;
//   * anything this stage cannot honour is reported as FALLBACK and lowered to
//     a trapping stub rather than silently miscompiled.  Every specialised
//     token's generic form is listed in bootstrap/ir.null.
//
// Outputs:
//   bootstrap/program.s       x86-64 assembly
//   bootstrap/backend.report  LOWERED / FALLBACK / STAT lines
// ---------------------------------------------------------------------------

fn index_of(list, value) -> Num {
    let found = LEN(list);
    let i = 0;
    while i < LEN(list) {
        if list[i] == value {
            found = i;
            break;
        }
        i = i + 1;
    }
    return found;
}

fn is_digit(c: Text) -> Bool {
    if c < "0" {
        return false;
    }
    if c > "9" {
        return false;
    }
    return true;
}

fn looks_numeric(text: Text) -> Bool {
    if LEN(text) == 0 {
        return false;
    }
    let ok = true;
    let digits = 0;
    let i = 0;
    while i < LEN(text) {
        let c = CHAR_AT(text, i);
        if is_digit(c) {
            digits = digits + 1;
        } else {
            if c != "." {
                if c != "-" {
                    ok = false;
                }
            }
        }
        i = i + 1;
    }
    if digits == 0 {
        ok = false;
    }
    return ok;
}

fn meta_value(meta: Text, key: Text) -> Text {
    let parts = SPLIT(meta, " ");
    let found = "";
    let i = 0;
    while i < LEN(parts) {
        let kv = SPLIT(parts[i], "=");
        if LEN(kv) > 1 {
            if kv[0] == key {
                found = kv[1];
            }
        }
        i = i + 1;
    }
    return found;
}

fn has_meta(meta: Text, key: Text) -> Bool {
    let parts = SPLIT(meta, " ");
    let found = false;
    let i = 0;
    while i < LEN(parts) {
        if parts[i] == key {
            found = true;
        }
        i = i + 1;
    }
    return found;
}

fn is_ident_char(c: Text) -> Bool {
    if LEN(c) == 0 {
        return false;
    }
    if is_digit(c) {
        return true;
    }
    if c == "_" {
        return true;
    }
    return false;
}

fn sanitize(text: Text) -> Text {
    let out = "";
    let i = 0;
    while i < LEN(text) {
        let c = CHAR_AT(text, i);
        let keep = false;
        if is_ident_char(c) {
            keep = true;
        }
        if c >= "a" {
            if c <= "z" {
                keep = true;
            }
        }
        if c >= "A" {
            if c <= "Z" {
                keep = true;
            }
        }
        if keep {
            out = out + c;
        } else {
            out = out + "_";
        }
        i = i + 1;
    }
    return out;
}

fn parse_rows(text: Text) -> Array {
    let lines = SPLIT(text, "\n");
    let rows = [];
    let i = 0;
    while i < LEN(lines) {
        let line = lines[i];
        if LEN(line) > 0 {
            let f = SPLIT(line, "\t");
            if f[0] == "LABEL" {
                if LEN(f) > 1 {
                    rows = APPEND(rows, ["LABEL", f[1]]);
                }
            } else {
                if f[0] == "IR" {
                    let meta = "";
                    if LEN(f) > 4 {
                        meta = f[4];
                    }
                    rows = APPEND(rows, ["IR", TO_NUMBER(f[1]), f[2], f[3], meta]);
                }
            }
        }
        i = i + 1;
    }
    return rows;
}

// --- expression trees for fused comprehensions -----------------------------
// The emitter writes a comprehension pattern as
//   <var>|<expr>|<pred>
// where each expression is a prefix dump:
//   NUM 2 | IDENT x | BINARY * <l> <r> | UNARY - <e> | NOT <e>
fn parse_term(toks, pos) -> Array {
    if pos >= LEN(toks) {
        return [["bad"], pos];
    }
    let head = toks[pos];
    if head == "NUM" {
        if pos + 1 < LEN(toks) {
            return [["num", toks[pos + 1]], pos + 2];
        }
        return [["bad"], pos + 1];
    }
    if head == "IDENT" {
        if pos + 1 < LEN(toks) {
            return [["id", toks[pos + 1]], pos + 2];
        }
        return [["bad"], pos + 1];
    }
    if head == "NOT" {
        let inner = parse_term(toks, pos + 1);
        return [["not", inner[0]], inner[1]];
    }
    if head == "UNARY" {
        if pos + 1 >= LEN(toks) {
            return [["bad"], pos + 1];
        }
        let op = toks[pos + 1];
        let inner = parse_term(toks, pos + 2);
        return [["un", op, inner[0]], inner[1]];
    }
    if head == "BINARY" {
        if pos + 2 >= LEN(toks) {
            return [["bad"], pos + 1];
        }
        let op = toks[pos + 1];
        let left = parse_term(toks, pos + 2);
        let right = parse_term(toks, left[1]);
        return [["bin", op, left[0], right[0]], right[1]];
    }
    if head == "BOOL" {
        if pos + 1 < LEN(toks) {
            return [["num", "0"], pos + 2];
        }
    }
    return [["bad"], pos + 1];
}

fn tree_from(text: Text) -> Array {
    if LEN(text) == 0 {
        return ["none"];
    }
    let toks = SPLIT(text, " ");
    let parsed = parse_term(toks, 0);
    if parsed[1] != LEN(toks) {
        return ["bad"];
    }
    return parsed[0];
}

fn tree_status(tree) -> Text {
    if LEN(tree) == 0 {
        return "bad";
    }
    if tree[0] == "none" {
        return "none";
    }
    if tree[0] == "bad" {
        return "bad";
    }
    if tree[0] == "num" {
        return "ok";
    }
    if tree[0] == "id" {
        return "ok";
    }
    if tree[0] == "not" {
        return tree_status(tree[1]);
    }
    if tree[0] == "un" {
        return tree_status(tree[2]);
    }
    if tree[0] == "bin" {
        let a = tree_status(tree[2]);
        let b = tree_status(tree[3]);
        if a == "ok" {
            if b == "ok" {
                return "ok";
            }
        }
        return "bad";
    }
    return "bad";
}

// Emits code computing `tree` into frame slot `dest`.  `vofs` is the frame
// offset of the comprehension variable, used by IDENT leaves.
fn emit_tree(out, tree, dest: Num, vofs: Num) -> Array {
    let o = out;
    let tag = tree[0];
    if tag == "num" {
        o = APPEND(o, "  mov qword ptr [rbp - " + TO_STRING(dest) + "], " + tree[1]);
    }
    if tag == "id" {
        o = APPEND(o, "  mov rax, qword ptr [rbp - " + TO_STRING(vofs) + "]");
        o = APPEND(o, "  mov qword ptr [rbp - " + TO_STRING(dest) + "], rax");
    }
    if tag == "not" {
        o = emit_tree(o, tree[1], dest, vofs);
        o = APPEND(o, "  cmp qword ptr [rbp - " + TO_STRING(dest) + "], 0");
        o = APPEND(o, "  sete al");
        o = APPEND(o, "  movzx rax, al");
        o = APPEND(o, "  mov qword ptr [rbp - " + TO_STRING(dest) + "], rax");
    }
    if tag == "un" {
        o = emit_tree(o, tree[2], dest, vofs);
        if tree[1] == "-" {
            o = APPEND(o, "  neg qword ptr [rbp - " + TO_STRING(dest) + "]");
        }
    }
    if tag == "bin" {
        let right_dest = dest + 64;
        o = emit_tree(o, tree[2], dest, vofs);
        o = emit_tree(o, tree[3], right_dest, vofs);
        let op = tree[1];
        let d = "  mov rax, qword ptr [rbp - " + TO_STRING(right_dest) + "]";
        if op == "+" {
            o = APPEND(o, d);
            o = APPEND(o, "  add qword ptr [rbp - " + TO_STRING(dest) + "], rax");
        }
        if op == "-" {
            o = APPEND(o, d);
            o = APPEND(o, "  sub qword ptr [rbp - " + TO_STRING(dest) + "], rax");
        }
        if op == "*" {
            o = APPEND(o, d);
            o = APPEND(o, "  imul rax, qword ptr [rbp - " + TO_STRING(dest) + "]");
            o = APPEND(o, "  mov qword ptr [rbp - " + TO_STRING(dest) + "], rax");
        }
        if op == "/" {
            o = APPEND(o, "  mov rax, qword ptr [rbp - " + TO_STRING(dest) + "]");
            o = APPEND(o, "  cqo");
            o = APPEND(o, "  idiv qword ptr [rbp - " + TO_STRING(right_dest) + "]");
            o = APPEND(o, "  mov qword ptr [rbp - " + TO_STRING(dest) + "], rax");
        }
        if op == "%" {
            o = APPEND(o, "  mov rax, qword ptr [rbp - " + TO_STRING(dest) + "]");
            o = APPEND(o, "  cqo");
            o = APPEND(o, "  idiv qword ptr [rbp - " + TO_STRING(right_dest) + "]");
            o = APPEND(o, "  mov qword ptr [rbp - " + TO_STRING(dest) + "], rdx");
        }
        if op == "==" {
            o = APPEND(o, d);
            o = APPEND(o, "  cmp qword ptr [rbp - " + TO_STRING(dest) + "], rax");
            o = APPEND(o, "  sete al");
            o = APPEND(o, "  movzx rax, al");
            o = APPEND(o, "  mov qword ptr [rbp - " + TO_STRING(dest) + "], rax");
        }
        if op == "!=" {
            o = APPEND(o, d);
            o = APPEND(o, "  cmp qword ptr [rbp - " + TO_STRING(dest) + "], rax");
            o = APPEND(o, "  setne al");
            o = APPEND(o, "  movzx rax, al");
            o = APPEND(o, "  mov qword ptr [rbp - " + TO_STRING(dest) + "], rax");
        }
        if op == "<" {
            o = APPEND(o, d);
            o = APPEND(o, "  cmp qword ptr [rbp - " + TO_STRING(dest) + "], rax");
            o = APPEND(o, "  setl al");
            o = APPEND(o, "  movzx rax, al");
            o = APPEND(o, "  mov qword ptr [rbp - " + TO_STRING(dest) + "], rax");
        }
        if op == "<=" {
            o = APPEND(o, d);
            o = APPEND(o, "  cmp qword ptr [rbp - " + TO_STRING(dest) + "], rax");
            o = APPEND(o, "  setle al");
            o = APPEND(o, "  movzx rax, al");
            o = APPEND(o, "  mov qword ptr [rbp - " + TO_STRING(dest) + "], rax");
        }
        if op == ">" {
            o = APPEND(o, d);
            o = APPEND(o, "  cmp qword ptr [rbp - " + TO_STRING(dest) + "], rax");
            o = APPEND(o, "  setg al");
            o = APPEND(o, "  movzx rax, al");
            o = APPEND(o, "  mov qword ptr [rbp - " + TO_STRING(dest) + "], rax");
        }
        if op == ">=" {
            o = APPEND(o, d);
            o = APPEND(o, "  cmp qword ptr [rbp - " + TO_STRING(dest) + "], rax");
            o = APPEND(o, "  setge al");
            o = APPEND(o, "  movzx rax, al");
            o = APPEND(o, "  mov qword ptr [rbp - " + TO_STRING(dest) + "], rax");
        }
    }
    return o;
}

// --- runtime support emitted into every module -----------------------------
// x - (x / 2^k) * 2^k == 0  ->  test x, 2^k-1 ; jne end
// This is the shape the front end emits for a modulo test, since `%` is not a
// token in the lexer. The identity holds for every signed x: the quotient times
// the divisor removes all low bits, so the difference is zero exactly when the
// low k bits of x are zero.
fn fast_rem_branch(rows, i, regs, slot_names) -> Array {
    // The front end emits the minuend first: LOAD x; LOAD x; LOAD k; DIV; ...
    // Match the longer window when that pair is present and report the span.
    let base = i;
    let span = 9;
    if i + 9 < LEN(rows) {
        if LEN(rows[i]) > 2 && LEN(rows[i + 1]) > 2 {
            if rows[i][1] == 2 && rows[i + 1][1] == 2 && rows[i][2] == rows[i + 1][2] {
                base = i + 1;
                span = 10;
            }
        }
    }
    if base + 8 >= LEN(rows) {
        return [];
    }
    let r0 = rows[base];
    let r1 = rows[base + 1];
    let r2 = rows[base + 2];
    let r3 = rows[base + 3];
    let r4 = rows[base + 4];
    let r5 = rows[base + 5];
    let r6 = rows[base + 6];
    let r7 = rows[base + 7];
    let r8 = rows[base + 8];
    if LEN(r0) < 3 || LEN(r1) < 3 || LEN(r2) < 3 || LEN(r3) < 3 || LEN(r4) < 3 {
        return [];
    }
    if LEN(r5) < 3 || LEN(r6) < 3 || LEN(r7) < 3 || LEN(r8) < 3 {
        return [];
    }
    if r0[1] != 2 || r1[1] != 1 || r2[1] != 13 || r3[1] != 1 || r4[1] != 12 {
        return [];
    }
    if r5[1] != 11 || r6[1] != 1 || r7[1] != 22 || r8[1] != 40 {
        return [];
    }
    if r1[2] != r3[2] || r6[2] != "0" {
        return [];
    }
    if looks_numeric(r1[2]) == false {
        return [];
    }
    let k = TO_NUMBER(r1[2]);
    if is_pow2(k) == false {
        return [];
    }
    let ra = reg_of(r0[2], regs, slot_names);
    if ra == "" {
        return [];
    }
    return ["  test " + ra + ", " + TO_STRING(k - 1), "  jne .L" + r8[2], TO_STRING(span)];
}

fn is_pow2(k: Num) -> Bool {
    let n = k;
    if n < 1 {
        return false;
    }
    while n > 1 {
        if n / 2 * 2 != n {
            return false;
        }
        n = n / 2;
    }
    return true;
}

// c = c + a * b, all in registers  ->  mov/imul/add (no stack traffic).
fn fast_mul_add(rows, i, regs, slot_names) -> Array {
    if i + 5 >= LEN(rows) {
        return [];
    }
    let r0 = rows[i];
    let r1 = rows[i + 1];
    let r2 = rows[i + 2];
    let r3 = rows[i + 3];
    let r4 = rows[i + 4];
    let r5 = rows[i + 5];
    if LEN(r0) < 3 || LEN(r1) < 3 || LEN(r2) < 3 || LEN(r3) < 3 || LEN(r4) < 3 || LEN(r5) < 3 {
        return [];
    }
    if r0[1] != 2 || r1[1] != 2 || r2[1] != 2 {
        return [];
    }
    if r3[1] != 12 {
        return [];
    }
    if r4[1] != 100 && r4[1] != 10 {
        return [];
    }
    if r5[1] != 3 {
        return [];
    }
    let rc = reg_of(r0[2], regs, slot_names);
    let ra = reg_of(r1[2], regs, slot_names);
    let rb = reg_of(r2[2], regs, slot_names);
    let rd = reg_of(r5[2], regs, slot_names);
    if rc == "" || ra == "" || rb == "" || rd == "" {
        return [];
    }
    if rc != rd {
        return [];
    }
    if r0[2] != r5[2] {
        return [];
    }
    return ["  mov rax, " + ra, "  imul rax, " + rb, "  add " + rc + ", rax"];
}

// (x MOD 2^k) == 0  ->  test x, 2^k-1 ; jne end
// Two's complement multiples of a power of two have their low bits clear, so
// the division is never needed for this comparison.
fn fast_mod_branch(rows, i, regs, slot_names) -> Array {
    if i + 5 >= LEN(rows) {
        return [];
    }
    let r0 = rows[i];
    let r1 = rows[i + 1];
    let r2 = rows[i + 2];
    let r3 = rows[i + 3];
    let r4 = rows[i + 4];
    let r5 = rows[i + 5];
    if LEN(r0) < 3 || LEN(r1) < 3 || LEN(r2) < 3 || LEN(r3) < 3 || LEN(r4) < 3 || LEN(r5) < 3 {
        return [];
    }
    if r0[1] != 2 {
        return [];
    }
    if r1[1] != 1 {
        return [];
    }
    if r2[1] != 70 {
        return [];
    }
    if r2[2] != "MOD" {
        return [];
    }
    if r3[1] != 1 {
        return [];
    }
    if r3[2] != "0" {
        return [];
    }
    if r4[1] != 22 {
        return [];
    }
    if r5[1] != 40 {
        return [];
    }
    let ra = reg_of(r0[2], regs, slot_names);
    if ra == "" {
        return [];
    }
    if looks_numeric(r1[2]) == false {
        return [];
    }
    let k = TO_NUMBER(r1[2]);
    if is_pow2(k) == false {
        return [];
    }
    return ["  test " + ra + ", " + TO_STRING(k - 1), "  jne .L" + r5[2]];
}

// Three-row window: LOAD a; LOAD b|const; ARITH. The result stays in rax and is
// also pushed to the operand stack, so following generic rows still work.
fn fast_partial(rows, i, regs, slot_names, sp) -> Array {
    if i + 2 >= LEN(rows) {
        return [];
    }
    let r0 = rows[i];
    let r1 = rows[i + 1];
    let r2 = rows[i + 2];
    if LEN(r0) < 3 || LEN(r1) < 3 || LEN(r2) < 3 {
        return [];
    }
    if r0[1] != 2 {
        return [];
    }
    let ra = reg_of(r0[2], regs, slot_names);
    if ra == "" {
        return [];
    }
    let mnem = bin_mnemonic(r2[1]);
    if mnem == "" {
        return [];
    }
    let off = TO_STRING(4096 + sp * 8);
    if r1[1] == 2 {
        let rb = reg_of(r1[2], regs, slot_names);
        if rb == "" {
            return [];
        }
        return ["  mov rax, " + ra, "  " + mnem + " rax, " + rb, "  mov qword ptr [rbp - " + off + "], rax"];
    }
    if r1[1] == 1 {
        if looks_numeric(r1[2]) {
            return ["  mov rax, " + ra, "  " + mnem + " rax, " + r1[2], "  mov qword ptr [rbp - " + off + "], rax"];
        }
    }
    return [];
}

fn reg_of(name, regs, slot_names) -> Text {
    let idx = index_of(slot_names, name);
    if idx < LEN(regs) {
        return regs[idx];
    }
    return "";
}

fn cmp_cc(op: Num) -> Text {
    if op == 102 {
        return "l";
    }
    if op == 20 {
        return "g";
    }
    if op == 21 {
        return "l";
    }
    if op == 22 {
        return "e";
    }
    if op == 23 {
        return "ne";
    }
    if op == 24 {
        return "ge";
    }
    if op == 25 {
        return "le";
    }
    return "";
}

fn bin_mnemonic(op: Num) -> Text {
    if op == 100 {
        return "add";
    }
    if op == 10 {
        return "add";
    }
    if op == 11 {
        return "sub";
    }
    if op == 12 {
        return "imul";
    }
    return "";
}

// Instruction selection over four consecutive IR rows: when both operands and
// the destination are in registers, the whole stack round-trip collapses to a
// register-to-register operation. Returns [] when the window does not match.
fn fast_pattern(rows, i, regs, slot_names) -> Array {
    if i + 3 >= LEN(rows) {
        return [];
    }
    let r0 = rows[i];
    let r1 = rows[i + 1];
    let r2 = rows[i + 2];
    let r3 = rows[i + 3];
    if LEN(r0) < 3 {
        return [];
    }
    if LEN(r1) < 3 {
        return [];
    }
    if LEN(r2) < 3 {
        return [];
    }
    if LEN(r3) < 3 {
        return [];
    }
    if r0[1] != 2 {
        return [];
    }
    let ra = reg_of(r0[2], regs, slot_names);
    if ra == "" {
        return [];
    }
    let op = r2[1];

    // compare + conditional branch
    let cc = cmp_cc(op);
    if cc != "" {
        let inv = cc_jump_inverse(cc);
        if r3[1] == 40 {
            if r1[1] == 2 {
                let rb = reg_of(r1[2], regs, slot_names);
                if rb != "" {
                    return ["  cmp " + ra + ", " + rb, "  " + inv + " .L" + r3[2]];
                }
            }
            if r1[1] == 1 {
                if looks_numeric(r1[2]) {
                    return ["  cmp " + ra + ", " + r1[2], "  " + inv + " .L" + r3[2]];
                }
            }
        }
        return [];
    }

    // arithmetic into a register
    let mnem = bin_mnemonic(op);
    if mnem == "" {
        return [];
    }
    if r3[1] != 3 {
        return [];
    }
    let rc = reg_of(r3[2], regs, slot_names);
    if rc == "" {
        return [];
    }
    if r1[1] == 2 {
        let rb = reg_of(r1[2], regs, slot_names);
        if rb == "" {
            return [];
        }
        if rc == ra {
            return ["  " + mnem + " " + ra + ", " + rb];
        }
        return ["  mov rax, " + ra, "  " + mnem + " rax, " + rb, "  mov " + rc + ", rax"];
    }
    if r1[1] == 1 {
        if looks_numeric(r1[2]) {
            if rc == ra {
                return ["  " + mnem + " " + ra + ", " + r1[2]];
            }
            return ["  mov rax, " + ra, "  " + mnem + " rax, " + r1[2], "  mov " + rc + ", rax"];
        }
    }
    return [];
}

fn find_text(text, needle) -> Num {
    let n = LEN(needle);
    let i = 0;
    while i + n <= LEN(text) {
        if SUBSTR(text, i, i + n) == needle {
            return i;
        }
        i = i + 1;
    }
    return LEN(text);
}

fn slot_addr(line) -> Text {
    let pos = find_text(line, "[rbp - ");
    if pos == LEN(line) {
        return "";
    }
    let rest = SUBSTR(line, pos, LEN(line));
    let end = find_text(rest, "]");
    return SUBSTR(line, pos, pos + end);
}

fn is_slot_load(line) -> Bool {
    if starts_with(line, "  mov rax, qword ptr [rbp - ") {
        return true;
    }
    return false;
}

fn is_slot_store_rax(line) -> Bool {
    if starts_with(line, "  mov qword ptr [rbp - ") {
        if SUBSTR(line, LEN(line) - 5, LEN(line)) == ", rax" {
            return true;
        }
    }
    return false;
}

// Redundant-load elimination: a load of a slot that was just written from rax
// is dead, because the value is still in rax.
fn peephole(lines) -> Array {
    let kept = [];
    let i = 0;
    while i < LEN(lines) {
        let line = lines[i];
        let skip = false;
        if LEN(kept) > 0 {
            let prev = kept[LEN(kept) - 1];
            if is_slot_load(line) {
                if is_slot_store_rax(prev) {
                    if slot_addr(line) == slot_addr(prev) {
                        skip = true;
                    }
                }
            }
        }
        if skip == false {
            kept = APPEND(kept, line);
        }
        i = i + 1;
    }
    return kept;
}

fn cc_jump_inverse(cc: Text) -> Text {
    if cc == "l" {
        return "jge";
    }
    if cc == "g" {
        return "jle";
    }
    if cc == "le" {
        return "jg";
    }
    if cc == "ge" {
        return "jl";
    }
    if cc == "e" {
        return "jne";
    }
    if cc == "ne" {
        return "je";
    }
    return "";
}

// Compare + setCC + store + test + je  ->  compare + inverted conditional jump.
fn fuse_branches(lines) -> Array {
    let out = [];
    let i = 0;
    while i < LEN(lines) {
        if i + 5 < LEN(lines) {
            let c = lines[i];
            let sc = lines[i + 1];
            let zx = lines[i + 2];
            let st = lines[i + 3];
            let c2 = lines[i + 4];
            let j = lines[i + 5];
            let fused = "";
            if starts_with(c, "  cmp qword ptr [rbp - ") {
                if starts_with(sc, "  set") {
                    if zx == "  movzx rax, al" {
                        if is_slot_store_rax(st) {
                            if starts_with(c2, "  cmp qword ptr [rbp - ") {
                                if starts_with(j, "  je .L") {
                                    if slot_addr(c) == slot_addr(st) {
                                        if slot_addr(st) == slot_addr(c2) {
                                            let cc = SUBSTR(sc, 5, LEN(sc) - 3);
                                            let inv = cc_jump_inverse(cc);
                                            if inv != "" {
                                                out = APPEND(out, c);
                                                out = APPEND(out, "  " + inv + " " + SUBSTR(j, 5, LEN(j)));
                                                fused = "yes";
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if fused == "yes" {
                i = i + 6;
            } else {
                out = APPEND(out, lines[i]);
                i = i + 1;
            }
        } else {
            out = APPEND(out, lines[i]);
            i = i + 1;
        }
    }
    return out;
}

// Restore the callee-saved registers pushed in the prologue before every ret.
fn add_epilogues(lines) -> Array {
    let out = [];
    let i = 0;
    while i < LEN(lines) {
        if lines[i] == "  leave" {
            out = APPEND(out, "  pop r15");
            out = APPEND(out, "  pop r14");
            out = APPEND(out, "  pop r13");
            out = APPEND(out, "  pop r12");
        }
        out = APPEND(out, lines[i]);
        i = i + 1;
    }
    return out;
}

// Frequency-based allocation: the four most-referenced variables are held in
// r12-r15 for the whole function. Only applied to straight-line programs with
// no user-defined functions, because emitted functions share one frame.
fn reg_assignment(rows, slot_names) -> Array {
    let regs = [];
    let i = 0;
    while i < LEN(slot_names) {
        regs = APPEND(regs, "");
        i = i + 1;
    }
    let has_functions = false;
    i = 0;
    while i < LEN(rows) {
        if LEN(rows[i]) > 2 {
            if rows[i][1] == 74 {
                has_functions = true;
            }
            if rows[i][1] == 70 {
                if has_functions {
                    // a call into emitted code would share these registers
                }
            }
        }
        i = i + 1;
    }
    if has_functions {
        return [regs, []];
    }

    let counts = [];
    i = 0;
    while i < LEN(slot_names) {
        let name = slot_names[i];
        let c = 0;
        let j = 0;
        while j < LEN(rows) {
            if LEN(rows[j]) > 2 {
                let op = rows[j][1];
                if op == 2 {
                    if rows[j][2] == name {
                        c = c + 1;
                    }
                }
                if op == 3 {
                    if rows[j][2] == name {
                        c = c + 1;
                    }
                }
            }
            j = j + 1;
        }
        counts = APPEND(counts, c);
        i = i + 1;
    }

    let names = ["r12", "r13", "r14", "r15"];
    let hot = [];
    let r = 0;
    while r < 4 {
        let best = LEN(counts);
        let bestc = 1;
        let k = 0;
        while k < LEN(counts) {
            if counts[k] > bestc {
                bestc = counts[k];
                best = k;
            }
            k = k + 1;
        }
        if best < LEN(counts) {
            regs = replace_at(regs, best, names[r]);
            counts = replace_at(counts, best, 0);
            hot = APPEND(hot, best);
        }
        r = r + 1;
    }
    return [regs, hot];
}

fn runtime_lines() -> Array {
    return [
        "",
        "null_print_i64:",
        "  push rbp",
        "  mov rbp, rsp",
        "  sub rsp, 64",
        "  lea rsi, [rbp - 1]",
        "  mov r8, rsi",
        "  mov rax, rdi",
        "  xor ecx, ecx",
        "  test rax, rax",
        "  jns .Lpi_abs",
        "  neg rax",
        "  mov rcx, 1",
        ".Lpi_abs:",
        "  mov r9, 10",
        ".Lpi_loop:",
        "  xor edx, edx",
        "  div r9",
        "  add dl, 48",
        "  dec rsi",
        "  mov byte ptr [rsi], dl",
        "  test rax, rax",
        "  jnz .Lpi_loop",
        "  test rcx, rcx",
        "  jz .Lpi_out",
        "  dec rsi",
        "  mov byte ptr [rsi], 45",
        ".Lpi_out:",
        "  mov rdx, r8",
        "  sub rdx, rsi",
        "  mov rax, 1",
        "  mov rdi, 1",
        "  syscall",
        "  lea rsi, [rip + .Lnl]",
        "  mov rdx, 1",
        "  mov rax, 1",
        "  mov rdi, 1",
        "  syscall",
        "  leave",
        "  ret",
        "",
        "null_print_str:",
        "  push rbp",
        "  mov rbp, rsp",
        "  mov rsi, rdi",
        "  xor edx, edx",
        ".Lps_len:",
        "  cmp byte ptr [rsi + rdx], 0",
        "  je .Lps_out",
        "  inc rdx",
        "  jmp .Lps_len",
        ".Lps_out:",
        "  mov rax, 1",
        "  mov rdi, 1",
        "  syscall",
        "  lea rsi, [rip + .Lnl]",
        "  mov rdx, 1",
        "  mov rax, 1",
        "  mov rdi, 1",
        "  syscall",
        "  leave",
        "  ret",
        "",
        "null_array_new:",
        "  push rbp",
        "  mov rbp, rsp",
        "  push rbx",
        "  sub rsp, 8",
        "  mov rbx, rdi",
        "  lea rdi, [rdi * 8 + 8]",
        "  call malloc@PLT",
        "  mov qword ptr [rax], rbx",
        "  add rsp, 8",
        "  pop rbx",
        "  leave",
        "  ret",
        "",
        "null_array_zero:",
        "  push rbp",
        "  mov rbp, rsp",
        "  push rbx",
        "  sub rsp, 8",
        "  mov rbx, rdi",
        "  lea rdi, [rbx + 1]",
        "  mov rsi, 8",
        "  call calloc@PLT",
        "  mov qword ptr [rax], rbx",
        "  add rsp, 8",
        "  pop rbx",
        "  leave",
        "  ret",
        "",
        "null_panic_oob:",
        "  lea rsi, [rip + .Loob]",
        "  mov rdx, 12",
        "  mov rax, 1",
        "  mov rdi, 2",
        "  syscall",
        "  mov rax, 60",
        "  mov rdi, 3",
        "  syscall",
        "",
        "null_unsupported:",
        "  lea rsi, [rip + .Lunsup]",
        "  mov rdx, 16",
        "  mov rax, 1",
        "  mov rdi, 2",
        "  syscall",
        "  mov rax, 60",
        "  mov rdi, 4",
        "  syscall",
        "",
        "null_simd_add:",
        "  push rbp",
        "  mov rbp, rsp",
        "  push rbx",
        "  push r12",
        "  push r13",
        "  sub rsp, 8",
        "  mov rbx, rdi",
        "  mov r12, rsi",
        "  mov r13, qword ptr [rdi]",
        "  mov rax, qword ptr [r12]",
        "  cmp r13, rax",
        "  jle .Lsa_n",
        "  mov r13, rax",
        ".Lsa_n:",
        "  mov rdi, r13",
        "  call null_array_new",
        "  mov r9, rax",
        "  xor rcx, rcx",
        ".Lsa_v:",
        "  lea rdx, [rcx + 4]",
        "  cmp rdx, r13",
        "  jg .Lsa_tail",
        "  vmovdqu ymm0, ymmword ptr [rbx + rcx * 8 + 8]",
        "  vpaddq ymm0, ymm0, ymmword ptr [r12 + rcx * 8 + 8]",
        "  vmovdqu ymmword ptr [r9 + rcx * 8 + 8], ymm0",
