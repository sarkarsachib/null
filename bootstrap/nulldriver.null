        "  jmp .Lss_v",
        ".Lss_tail:",
        "  vextracti128 xmm1, ymm0, 1",
        "  vpaddq xmm0, xmm0, xmm1",
        "  vpsrldq xmm1, xmm0, 8",
        "  vpaddq xmm0, xmm0, xmm1",
        "  vmovq rax, xmm0",
        ".Lss_scalar:",
        "  cmp r8, rcx",
        "  jge .Lss_done",
        "  add rax, qword ptr [rbx + r8 * 8 + 8]",
        "  inc r8",
        "  jmp .Lss_scalar",
        ".Lss_done:",
        "  vzeroupper",
        "  add rsp, 8",
        "  pop rbx",
        "  leave",
        "  ret",
        "",
        "null_simd_mul:",
        "  push rbp",
        "  mov rbp, rsp",
        "  push rbx",
        "  push r12",
        "  push r13",
        "  sub rsp, 8",
        "  mov rbx, rdi",
        "  mov r12, rsi",
        "  and rbx, qword ptr [rip + .Lmask]",
        "  and r12, qword ptr [rip + .Lmask]",
        "  mov r13, qword ptr [rbx]",
        "  mov rax, qword ptr [r12]",
        "  cmp r13, rax",
        "  jle .Lsm_n",
        "  mov r13, rax",
        ".Lsm_n:",
        "  mov rdi, r13",
        "  call null_array_new",
        "  mov r9, rax",
        "  xor rcx, rcx",
        ".Lsm_v:",
        "  lea rdx, [rcx + 4]",
        "  cmp rdx, r13",
        "  jg .Lsm_tail",
        "  vmovdqu ymm0, ymmword ptr [rbx + rcx * 8 + 8]",
        "  vmovdqu ymm1, ymmword ptr [r12 + rcx * 8 + 8]",
        "  vpsrlq ymm2, ymm0, 32",
        "  vpsrlq ymm3, ymm1, 32",
        "  vpmuludq ymm4, ymm0, ymm1",
        "  vpmuludq ymm2, ymm2, ymm1",
        "  vpmuludq ymm3, ymm3, ymm0",
        "  vpaddq ymm2, ymm2, ymm3",
        "  vpsllq ymm2, ymm2, 32",
        "  vpaddq ymm0, ymm4, ymm2",
        "  vmovdqu ymmword ptr [r9 + rcx * 8 + 8], ymm0",
        "  add rcx, 4",
        "  jmp .Lsm_v",
        ".Lsm_tail:",
        "  cmp rcx, r13",
        "  jge .Lsm_done",
        ".Lsm_scalar:",
        "  mov rax, qword ptr [rbx + rcx * 8 + 8]",
        "  imul rax, qword ptr [r12 + rcx * 8 + 8]",
        "  mov qword ptr [r9 + rcx * 8 + 8], rax",
        "  inc rcx",
        "  cmp rcx, r13",
        "  jl .Lsm_scalar",
        ".Lsm_done:",
        "  vzeroupper",
        "  mov rax, r9",
        "  bts rax, 63",
        "  add rsp, 8",
        "  pop r13",
        "  pop r12",
        "  pop rbx",
        "  leave",
        "  ret",
    ];
}

fn fast_vec_reduce(rows, i, regs, slot_names) -> Array {
    if i + 13 >= LEN(rows) {
        return [];
    }
    let r0 = rows[i];
    if LEN(r0) < 2 {
        return [];
    }
    if r0[0] != "LABEL" {
        return [];
    }
    let r1 = rows[i + 1];
    let r2 = rows[i + 2];
    let r3 = rows[i + 3];
    let r4 = rows[i + 4];
    let r5 = rows[i + 5];
    let r6 = rows[i + 6];
    let r7 = rows[i + 7];
    let r8 = rows[i + 8];
    let r9 = rows[i + 9];
    let r10 = rows[i + 10];
    let r11 = rows[i + 11];
    let r12 = rows[i + 12];
    let r13 = rows[i + 13];
    if LEN(r1) < 3 || LEN(r2) < 3 || LEN(r3) < 3 || LEN(r4) < 3 || LEN(r5) < 3 {
        return [];
    }
    if LEN(r6) < 3 || LEN(r7) < 3 || LEN(r8) < 3 || LEN(r9) < 3 || LEN(r10) < 3 {
        return [];
    }
    if LEN(r11) < 3 || LEN(r12) < 3 || LEN(r13) < 3 {
        return [];
    }
    // LOAD iv; LOAD n; compare; JUMP_IF_FALSE exit
    if r1[1] != 2 || r2[1] != 2 || r4[1] != 40 {
        return [];
    }
    // 21/102 are `<`, 25/103 are `<=`; each inverts to one conditional jump.
    let is_lt = r3[1] == 21 || r3[1] == 102;
    let is_le = r3[1] == 25 || r3[1] == 103;
    if is_lt == false && is_le == false {
        return [];
    }
    // LOAD acc; LOAD iv; ADD; STORE acc
    if r5[1] != 2 || r6[1] != 2 || r8[1] != 3 {
        return [];
    }
    if r7[1] != 100 && r7[1] != 10 {
        return [];
    }
    // LOAD iv; LOAD 1; ADD; STORE iv
    if r9[1] != 2 || r10[1] != 1 || r11[1] != 100 && r11[1] != 10 || r12[1] != 3 {
        return [];
    }
    if r10[2] != "1" || r13[1] != 41 {
        return [];
    }
    if r5[2] != r8[2] || r1[2] != r12[2] || r1[2] != r9[2] {
        return [];
    }
    if r13[2] != r0[1] {
        return [];
    }
    let iv = reg_of(r1[2], regs, slot_names);
    let nn = reg_of(r2[2], regs, slot_names);
    let acc = reg_of(r5[2], regs, slot_names);
    if iv == "" || nn == "" || acc == "" {
        return [];
    }
    if acc == iv || acc == nn || iv == nn {
        return [];
    }
    let done = "  jg .L" + r0[1] + "_vt";
    let exit_cc = "  jg .L" + r4[2];
    if is_lt {
        done = "  jge .L" + r0[1] + "_vt";
        exit_cc = "  jge .L" + r4[2];
    }
    return [
        "  vmovq xmm0, " + iv,
        "  vpbroadcastq ymm1, xmm0",
        "  vpaddq ymm1, ymm1, ymmword ptr [rip + .Liota0]",
        "  vpaddq ymm3, ymm1, ymmword ptr [rip + .Lfour]",
        "  vpxor ymm2, ymm2, ymm2",
        "  vpxor ymm4, ymm4, ymm4",
        ".L" + r0[1] + "_v:",
        "  lea rdx, [" + iv + " + 8]",
        "  cmp rdx, " + nn,
        done,
        "  vpaddq ymm2, ymm2, ymm1",
        "  vpaddq ymm4, ymm4, ymm3",
        "  vpaddq ymm1, ymm1, ymmword ptr [rip + .Leight]",
        "  vpaddq ymm3, ymm3, ymmword ptr [rip + .Leight]",
        "  add " + iv + ", 8",
        "  jmp .L" + r0[1] + "_v",
        ".L" + r0[1] + "_vt:",
        "  vpaddq ymm2, ymm2, ymm4",
        "  vextracti128 xmm0, ymm2, 1",
        "  vpaddq xmm0, xmm0, xmm2",
        "  vpsrldq xmm1, xmm0, 8",
        "  vpaddq xmm0, xmm0, xmm1",
        "  vmovq rax, xmm0",
        "  add " + acc + ", rax",
        "  vzeroupper",
        ".L" + r0[1] + ":",
        "  cmp " + iv + ", " + nn,
        exit_cc,
        "  add " + acc + ", " + iv,
        "  add " + iv + ", 1",
        "  jmp .L" + r0[1],
    ];
}

fn fast_vec_filtered_square(rows, i, regs, slot_names) -> Array {
    if i + 29 >= LEN(rows) {
        return [];
    }
    let k = 0;
    let span = [];
    while k < 30 {
        span = APPEND(span, rows[i + k]);
        k = k + 1;
    }
    k = 0;
    while k < 30 {
        if LEN(span[k]) < 2 {
            return [];
        }
        k = k + 1;
    }
    if span[0][0] != "LABEL" || span[29][0] != "LABEL" {
        return [];
    }
    if span[22][0] != "LABEL" || span[23][0] != "LABEL" {
        return [];
    }
    if LEN(span[1]) < 3 || LEN(span[5]) < 3 || LEN(span[7]) < 3 || LEN(span[9]) < 3 {
        return [];
    }
    if LEN(span[15]) < 3 || LEN(span[17]) < 3 || LEN(span[20]) < 3 || LEN(span[28]) < 3 {
        return [];
    }
    // LOAD iv; LOAD n; compare; JUMP_IF_FALSE exit
    if span[1][1] != 2 || span[2][1] != 2 || span[4][1] != 40 {
        return [];
    }
    let is_lt = span[3][1] == 21 || span[3][1] == 102;
    let is_le = span[3][1] == 25 || span[3][1] == 103;
    if is_lt == false && is_le == false {
        return [];
    }
    // LOAD iv; LOAD iv; LOAD c; DIV; LOAD c; MUL; SUB; LOAD 0; EQ; JIF else
    if span[5][1] != 2 || span[6][1] != 2 || span[7][1] != 1 || span[8][1] != 13 {
        return [];
    }
    if span[9][1] != 1 || span[10][1] != 12 || span[11][1] != 11 || span[12][1] != 1 {
        return [];
    }
    if span[13][1] != 22 || span[14][1] != 40 {
        return [];
    }
    // LOAD acc; LOAD iv; LOAD iv; MUL; ADD; STORE acc; JUMP end-of-block
    if span[15][1] != 2 || span[16][1] != 2 || span[17][1] != 2 || span[18][1] != 12 {
        return [];
    }
    if span[19][1] != 100 && span[19][1] != 10 {
        return [];
    }
    if span[20][1] != 3 || span[21][1] != 41 {
        return [];
    }
    // LOAD iv; LOAD 1; ADD; STORE iv; JUMP loop
    if span[24][1] != 2 || span[25][1] != 1 || span[27][1] != 3 || span[28][1] != 41 {
        return [];
    }
    if span[26][1] != 100 && span[26][1] != 10 {
        return [];
    }
    if span[25][2] != "1" {
        return [];
    }
    // every operand must be the same variable the shape says it is
    if span[6][2] != span[1][2] || span[16][2] != span[1][2] || span[17][2] != span[1][2] {
        return [];
    }
    if span[24][2] != span[1][2] || span[7][2] != span[9][2] {
        return [];
    }
    if span[15][2] != span[20][2] {
        return [];
    }
    if span[4][2] != span[29][1] || span[14][2] != span[22][1] || span[21][2] != span[23][1] {
        return [];
    }
    if span[28][2] != span[0][1] {
        return [];
    }
    // c must be a power of two >= 2, so divisibility is a bit test
    let cnum = TO_NUMBER(span[7][2]);
    if cnum < 2 {
        return [];
    }
    let step = cnum;
    while step > 1 {
        if step - (step / 2) * 2 != 0 {
            return [];
        }
        step = step / 2;
    }
    let iv = reg_of(span[1][2], regs, slot_names);
    let nn = reg_of(span[2][2], regs, slot_names);
    let acc = reg_of(span[15][2], regs, slot_names);
    if iv == "" || nn == "" || acc == "" {
        return [];
    }
    if acc == iv || acc == nn || iv == nn {
        return [];
    }
    let lbl = span[0][1];
    let skip = ".L" + lbl + "_fsk";
    let done = "  jg .L" + lbl + "_fvt";
    let exit_cc = "  jg .L" + span[4][2];
    if is_lt {
        done = "  jge .L" + lbl + "_fvt";
        exit_cc = "  jge .L" + span[4][2];
    }
    let mask = TO_STRING(cnum - 1);
    // one lane block: square ymmX in place into ymm8, mask by (v & (c-1)) == 0
    let body = [
        "  vmovq xmm0, " + iv,
        "  vpbroadcastq ymm5, xmm0",
        "  vpaddq ymm1, ymm5, ymmword ptr [rip + .Liota0]",
        "  vpaddq ymm2, ymm5, ymmword ptr [rip + .Liota0]",
        "  vpaddq ymm2, ymm2, ymmword ptr [rip + .Lfour]",
        "  vpxor ymm3, ymm3, ymm3",
        "  vpxor ymm4, ymm4, ymm4",
        "  vpxor ymm7, ymm7, ymm7",
        "  mov rax, " + mask,
        "  vmovq xmm0, rax",
        "  vpbroadcastq ymm6, xmm0",
        ".L" + lbl + "_fv:",
        "  lea rdx, [" + iv + " + 8]",
        "  cmp rdx, " + nn,
        done,
    ];
    let lane = 1;
    while lane < 3 {
        let vec = "ymm1";
        let tgt = "ymm3";
        if lane == 2 {
            vec = "ymm2";
            tgt = "ymm4";
        }
        body = APPEND(body, "  vpsrlq ymm8, " + vec + ", 32");
        body = APPEND(body, "  vpmuludq ymm9, " + vec + ", " + vec);
        body = APPEND(body, "  vpmuludq ymm8, ymm8, " + vec);
        body = APPEND(body, "  vpaddq ymm8, ymm8, ymm8");
        body = APPEND(body, "  vpsllq ymm8, ymm8, 32");
        body = APPEND(body, "  vpaddq ymm8, ymm9, ymm8");
        body = APPEND(body, "  vpand ymm10, " + vec + ", ymm6");
        body = APPEND(body, "  vpcmpeqq ymm10, ymm10, ymm7");
        body = APPEND(body, "  vpand ymm8, ymm8, ymm10");
        body = APPEND(body, "  vpaddq " + tgt + ", " + tgt + ", ymm8");
        lane = lane + 1;
    }
    body = APPEND(body, "  vpaddq ymm1, ymm1, ymmword ptr [rip + .Leight]");
    body = APPEND(body, "  vpaddq ymm2, ymm2, ymmword ptr [rip + .Leight]");
    body = APPEND(body, "  add " + iv + ", 8");
    body = APPEND(body, "  jmp .L" + lbl + "_fv");
    body = APPEND(body, ".L" + lbl + "_fvt:");
    body = APPEND(body, "  vpaddq ymm3, ymm3, ymm4");
    body = APPEND(body, "  vextracti128 xmm0, ymm3, 1");
    body = APPEND(body, "  vpaddq xmm0, xmm0, xmm3");
    body = APPEND(body, "  vpsrldq xmm1, xmm0, 8");
    body = APPEND(body, "  vpaddq xmm0, xmm0, xmm1");
    body = APPEND(body, "  vmovq rax, xmm0");
    body = APPEND(body, "  add " + acc + ", rax");
    body = APPEND(body, "  vzeroupper");
    // scalar tail: the same loop the emitter would have produced
    body = APPEND(body, ".L" + lbl + ":");
    body = APPEND(body, "  cmp " + iv + ", " + nn);
    body = APPEND(body, exit_cc);
    body = APPEND(body, "  mov rax, " + iv);
    body = APPEND(body, "  and rax, " + mask);
    body = APPEND(body, "  jne " + skip);
    body = APPEND(body, "  mov rax, " + iv);
    body = APPEND(body, "  imul rax, rax");
    body = APPEND(body, "  add " + acc + ", rax");
    body = APPEND(body, skip + ":");
    body = APPEND(body, "  add " + iv + ", 1");
    body = APPEND(body, "  jmp .L" + lbl);
    return body;
}

fn scalar_operand(name, regs, slot_names) -> Text {
    let idx = index_of(slot_names, name);
    if idx == LEN(slot_names) {
        return "";
    }
    if idx < LEN(regs) {
        if regs[idx] != "" {
            return regs[idx];
        }
    }
    return "qword ptr [rbp - " + TO_STRING(200 + idx * 8) + "]";
}

fn fast_vec_array_fill(rows, i, regs, slot_names) -> Array {
    if i + 21 >= LEN(rows) {
        return [];
    }
    let k = 0;
    let span = [];
    while k < 22 {
        span = APPEND(span, rows[i + k]);
        k = k + 1;
    }
    k = 0;
    while k < 22 {
        if LEN(span[k]) < 2 {
            return [];
        }
        k = k + 1;
    }
    if span[0][0] != "LABEL" || LEN(span[1]) < 3 || LEN(span[2]) < 3 {
        return [];
    }
    if span[4][1] != 40 {
        return [];
    }
    let is_lt = span[3][1] == 21 || span[3][1] == 102;
    let is_le = span[3][1] == 25 || span[3][1] == 103;
    if is_lt == false && is_le == false {
        return [];
    }
    // LOAD a; LOAD iv; LOAD iv; INDEX_STORE; STORE a      (a[iv] = iv)
    if span[5][1] != 2 || span[6][1] != 2 || span[7][1] != 2 || span[8][1] != 105 {
        return [];
    }
    if span[9][1] != 3 {
        return [];
    }
    // LOAD b; LOAD iv; LOAD iv; LOAD 2; MUL; INDEX_STORE; STORE b
    if span[10][1] != 2 || span[11][1] != 2 || span[12][1] != 2 || span[13][1] != 1 {
        return [];
    }
    if span[14][1] != 12 || span[15][1] != 105 || span[16][1] != 3 {
        return [];
    }
    // LOAD iv; LOAD 1; ADD; STORE iv; JUMP loop
    if span[17][1] != 2 || span[18][1] != 1 || span[20][1] != 3 || span[21][1] != 41 {
        return [];
    }
    if span[19][1] != 100 && span[19][1] != 10 {
        return [];
    }
    if span[13][2] != "2" || span[18][2] != "1" {
        return [];
    }
    // every operand must be the variable the shape says it is
    if span[6][2] != span[1][2] || span[7][2] != span[1][2] || span[11][2] != span[1][2] {
        return [];
    }
    if span[12][2] != span[1][2] || span[17][2] != span[1][2] || span[20][2] != span[1][2] {
        return [];
    }
    if span[9][2] != span[5][2] || span[16][2] != span[10][2] {
        return [];
    }
    if span[21][2] != span[0][1] {
        return [];
    }
    if span[5][2] == span[10][2] || span[5][2] == span[1][2] || span[10][2] == span[1][2] {
        return [];
    }
    if span[5][2] == span[2][2] || span[10][2] == span[2][2] || span[1][2] == span[2][2] {
        return [];
    }
    // The four values do not all have to be promoted: a pointer or the index
    // that stayed in its frame slot is loaded into a scratch register once, and
    // a spilled index is written back on the way out so following code sees it.
    let lbl = span[0][1];
    let prelude = [];
    let iv = reg_of(span[1][2], regs, slot_names);
    let nn = reg_of(span[2][2], regs, slot_names);
    let ar = reg_of(span[5][2], regs, slot_names);
    let br = reg_of(span[10][2], regs, slot_names);
    let iv_slot = "";
    if iv == "" {
        iv_slot = "qword ptr [rbp - " + TO_STRING(200 + index_of(slot_names, span[1][2]) * 8) + "]";
        iv = "r9";
        prelude = APPEND(prelude, "  mov r9, " + iv_slot);
    }
    if nn == "" {
        nn = "r8";
        prelude = APPEND(prelude, "  mov r8, qword ptr [rbp - " + TO_STRING(200 + index_of(slot_names, span[2][2]) * 8) + "]");
    }
    // Array pointers are tagged, so the lane stores work on untagged copies in
    // scratch registers: a promoted register keeps its tagged value for the
    // code that follows the loop.
    if ar == "" {
        prelude = APPEND(prelude, "  mov r10, qword ptr [rbp - " + TO_STRING(200 + index_of(slot_names, span[5][2]) * 8) + "]");
    } else {
        prelude = APPEND(prelude, "  mov r10, " + ar);
    }
    prelude = APPEND(prelude, "  and r10, qword ptr [rip + .Lmask]");
    ar = "r10";
    if br == "" {
        prelude = APPEND(prelude, "  mov r11, qword ptr [rbp - " + TO_STRING(200 + index_of(slot_names, span[10][2]) * 8) + "]");
    } else {
        prelude = APPEND(prelude, "  mov r11, " + br);
    }
    prelude = APPEND(prelude, "  and r11, qword ptr [rip + .Lmask]");
    br = "r11";
    let tail = ".L" + lbl + "_at";
    let leave = ".L" + lbl + "_ax";
    let done = "  jg " + tail;
    let exit_cc = "  jg .L" + span[4][2];
    let guard = "  lea rdx, [" + iv + " + 4]";
    if is_lt {
        done = "  jge " + tail;
        exit_cc = "  jge .L" + span[4][2];
    }
    if is_le {
        guard = "  lea rdx, [" + iv + " + 3]";
    }
    if iv_slot != "" {
        exit_cc = "  jg " + leave;
        if is_lt {
            exit_cc = "  jge " + leave;
        }
    }
    let body = prelude;
    body = APPEND(body, "  vmovq xmm0, " + iv);
    body = APPEND(body, "  vpbroadcastq ymm1, xmm0");
    body = APPEND(body, "  vpaddq ymm1, ymm1, ymmword ptr [rip + .Liota0]");
    body = APPEND(body, "  vpaddq ymm2, ymm1, ymm1");
    body = APPEND(body, ".L" + lbl + "_av:");
    body = APPEND(body, guard);
    body = APPEND(body, "  cmp rdx, " + nn);
    body = APPEND(body, done);
    body = APPEND(body, "  vmovdqu ymmword ptr [" + ar + " + " + iv + "*8 + 8], ymm1");
    body = APPEND(body, "  vmovdqu ymmword ptr [" + br + " + " + iv + "*8 + 8], ymm2");
    body = APPEND(body, "  vpaddq ymm1, ymm1, ymmword ptr [rip + .Lfour]");
    body = APPEND(body, "  vpaddq ymm2, ymm2, ymmword ptr [rip + .Leight]");
    body = APPEND(body, "  add " + iv + ", 4");
    body = APPEND(body, "  jmp .L" + lbl + "_av");
    body = APPEND(body, tail + ":");
    body = APPEND(body, "  cmp " + iv + ", " + nn);
    body = APPEND(body, exit_cc);
    body = APPEND(body, "  mov qword ptr [" + ar + " + " + iv + "*8 + 8], " + iv);
    body = APPEND(body, "  lea rax, [" + iv + " + " + iv + "]");
    body = APPEND(body, "  mov qword ptr [" + br + " + " + iv + "*8 + 8], rax");
    body = APPEND(body, "  add " + iv + ", 1");
    body = APPEND(body, "  jmp " + tail);
    if iv_slot != "" {
        body = APPEND(body, leave + ":");
        body = APPEND(body, "  mov " + iv_slot + ", " + iv);
        body = APPEND(body, "  jmp .L" + span[4][2]);
    }
    return body;
}

fn fast_vec_array_axpy(rows, i, regs, slot_names) -> Array {
    if i + 21 >= LEN(rows) {
        return [];
    }
    let k = 0;
    let span = [];
    while k < 22 {
        span = APPEND(span, rows[i + k]);
        k = k + 1;
    }
    k = 0;
    while k < 22 {
        if LEN(span[k]) < 2 {
            return [];
        }
        k = k + 1;
    }
    if span[0][0] != "LABEL" || LEN(span[1]) < 3 || LEN(span[2]) < 3 {
        return [];
    }
    if span[4][1] != 40 {
        return [];
    }
    let is_lt = span[3][1] == 21 || span[3][1] == 102;
    let is_le = span[3][1] == 25 || span[3][1] == 103;
    if is_lt == false && is_le == false {
        return [];
    }
    // LOAD acc; LOAD a; LOAD iv; INDEX_LOAD; LOAD k; MUL
    if span[5][1] != 2 || span[6][1] != 2 || span[7][1] != 2 || span[8][1] != 103 {
        return [];
    }
    if span[9][1] != 1 || span[10][1] != 12 {
        return [];
    }
    // LOAD b; LOAD iv; INDEX_LOAD; ADD; ADD; STORE acc
    if span[11][1] != 2 || span[12][1] != 2 || span[13][1] != 103 {
        return [];
    }
    if span[14][1] != 100 || span[15][1] != 100 || span[16][1] != 3 {
        return [];
    }
    // LOAD iv; LOAD 1; ADD; STORE iv; JUMP loop
    if span[17][1] != 2 || span[18][1] != 1 || span[20][1] != 3 || span[21][1] != 41 {
        return [];
    }
    if span[19][1] != 100 && span[19][1] != 10 {
        return [];
    }
    if span[18][2] != "1" || span[21][2] != span[0][1] {
        return [];
    }
    if span[7][2] != span[1][2] || span[12][2] != span[1][2] || span[17][2] != span[1][2] {
        return [];
    }
    if span[20][2] != span[1][2] || span[16][2] != span[5][2] {
        return [];
    }
    if span[6][2] == span[11][2] {
        return [];
    }
    if span[5][2] == span[6][2] || span[5][2] == span[11][2] || span[5][2] == span[1][2] {
        return [];
    }
    if span[5][2] == span[2][2] || span[6][2] == span[1][2] {
        return [];
    }
    if span[11][2] == span[1][2] || span[1][2] == span[2][2] {
        return [];
    }
    let kk = TO_NUMBER(span[9][2]);
    if kk != 2 && kk != 3 && kk != 4 {
        return [];
    }
    // As in the fill pass, only the accumulator may live in memory: everything
    // else is loaded into a scratch register for the duration of the loop.
    let lbl = span[0][1];
    let prelude = [];
    let iv = reg_of(span[1][2], regs, slot_names);
    let nn = reg_of(span[2][2], regs, slot_names);
    let ar = reg_of(span[6][2], regs, slot_names);
    let br = reg_of(span[11][2], regs, slot_names);
    let acc = scalar_operand(span[5][2], regs, slot_names);
    if acc == "" {
        return [];
    }
    let iv_slot = "";
    if iv == "" {
        iv_slot = "qword ptr [rbp - " + TO_STRING(200 + index_of(slot_names, span[1][2]) * 8) + "]";
        iv = "r9";
        prelude = APPEND(prelude, "  mov r9, " + iv_slot);
    }
    if nn == "" {
        nn = "r8";
        prelude = APPEND(prelude, "  mov r8, qword ptr [rbp - " + TO_STRING(200 + index_of(slot_names, span[2][2]) * 8) + "]");
    }
    // As with the fill pass, the arrays are read through untagged scratch
    // copies so a promoted pointer register stays tagged for later code.
    if ar == "" {
        prelude = APPEND(prelude, "  mov r10, qword ptr [rbp - " + TO_STRING(200 + index_of(slot_names, span[6][2]) * 8) + "]");
    } else {
        prelude = APPEND(prelude, "  mov r10, " + ar);
    }
    prelude = APPEND(prelude, "  and r10, qword ptr [rip + .Lmask]");
    ar = "r10";
    if br == "" {
        prelude = APPEND(prelude, "  mov r11, qword ptr [rbp - " + TO_STRING(200 + index_of(slot_names, span[11][2]) * 8) + "]");
    } else {
        prelude = APPEND(prelude, "  mov r11, " + br);
    }
    prelude = APPEND(prelude, "  and r11, qword ptr [rip + .Lmask]");
    br = "r11";
    let vec_tail = ".L" + lbl + "_mvt";
    let tail = ".L" + lbl + "_mt2";
    let leave = ".L" + lbl + "_mx";
    let done = "  jg " + vec_tail;
    let exit_cc = "  jg .L" + span[4][2];
    let guard = "  lea rdx, [" + iv + " + 8]";
    if is_lt {
        done = "  jge " + vec_tail;
        exit_cc = "  jge .L" + span[4][2];
    }
    if is_le {
        guard = "  lea rdx, [" + iv + " + 7]";
    }
    if iv_slot != "" {
        exit_cc = "  jg " + leave;
        if is_lt {
            exit_cc = "  jge " + leave;
        }
    }
    let body = prelude;
    body = APPEND(body, "  vpxor ymm2, ymm2, ymm2");
    body = APPEND(body, "  vpxor ymm3, ymm3, ymm3");
    body = APPEND(body, ".L" + lbl + "_mv:");
    body = APPEND(body, guard);
    body = APPEND(body, "  cmp rdx, " + nn);
    body = APPEND(body, done);
    let lane = 1;
    while lane < 3 {
        let off = " + 8";
        let tgt = "ymm2";
        if lane == 2 {
            off = " + 40";
            tgt = "ymm3";
        }
        body = APPEND(body, "  vmovdqu ymm0, ymmword ptr [" + ar + " + " + iv + "*8" + off + "]");
        body = APPEND(body, "  vmovdqu ymm1, ymmword ptr [" + br + " + " + iv + "*8" + off + "]");
        if kk == 2 {
            body = APPEND(body, "  vpsllq ymm0, ymm0, 1");
        }
        if kk == 3 {
            body = APPEND(body, "  vpsllq ymm4, ymm0, 1");
            body = APPEND(body, "  vpaddq ymm0, ymm0, ymm4");
        }
        if kk == 4 {
            body = APPEND(body, "  vpsllq ymm0, ymm0, 2");
        }
        body = APPEND(body, "  vpaddq ymm0, ymm0, ymm1");
        body = APPEND(body, "  vpaddq " + tgt + ", " + tgt + ", ymm0");
        lane = lane + 1;
    }
    body = APPEND(body, "  add " + iv + ", 8");
    body = APPEND(body, "  jmp .L" + lbl + "_mv");
    body = APPEND(body, vec_tail + ":");
    body = APPEND(body, "  vpaddq ymm2, ymm2, ymm3");
    body = APPEND(body, "  vextracti128 xmm0, ymm2, 1");
    body = APPEND(body, "  vpaddq xmm0, xmm0, xmm2");
    body = APPEND(body, "  vpsrldq xmm1, xmm0, 8");
    body = APPEND(body, "  vpaddq xmm0, xmm0, xmm1");
    body = APPEND(body, "  vmovq rax, xmm0");
    body = APPEND(body, "  add " + acc + ", rax");
    body = APPEND(body, "  vzeroupper");
    body = APPEND(body, tail + ":");
    body = APPEND(body, "  cmp " + iv + ", " + nn);
    body = APPEND(body, exit_cc);
    body = APPEND(body, "  mov rax, qword ptr [" + ar + " + " + iv + "*8 + 8]");
    if kk == 2 {
        body = APPEND(body, "  lea rax, [rax + rax]");
    }
    if kk == 3 {
        body = APPEND(body, "  lea rax, [rax + rax*2]");
    }
    if kk == 4 {
        body = APPEND(body, "  lea rax, [rax*4]");
    }
    body = APPEND(body, "  add rax, qword ptr [" + br + " + " + iv + "*8 + 8]");
    body = APPEND(body, "  add " + acc + ", rax");
    body = APPEND(body, "  add " + iv + ", 1");
    body = APPEND(body, "  jmp " + tail);
    if iv_slot != "" {
        body = APPEND(body, leave + ":");
        body = APPEND(body, "  mov " + iv_slot + ", " + iv);
        body = APPEND(body, "  jmp .L" + span[4][2]);
    }
    return body;
}

fn compile(rows) -> Array {
    // Keep the process arguments for the ARGC/ARGV builtins. edi is argc and
    // rsi is argv at the C entry point.
    let out = [
        ".intel_syntax noprefix",
        ".text",
        ".globl main",
        "main:",
        "  push rbp",
        "  mov rbp, rsp",
        "  push r12",
        "  push r13",
        "  push r14",
        "  push r15",
        "  sub rsp, 16384",
        "  movsxd rax, edi",
        "  mov qword ptr [rip + .Largc], rax",
        "  mov qword ptr [rip + .Largv], rsi",
    ];
    let report = [];

    // --- pre-pass: frame slots for every variable + function table ----------
    let slot_names = [];
    let var_types = [];
    let fn_names = [];
    let fn_params = [];
    let fn_types = [];
    let fn_labels = [];
    let label_names = [];
    let i = 0;
    while i < LEN(rows) {
        let row = rows[i];
        if row[0] == "LABEL" {
            if index_of(label_names, row[1]) == LEN(label_names) {
                label_names = APPEND(label_names, row[1]);
            }
        } else {
            let op = row[1];
            let operand = row[2];
            if op == 74 {
                fn_names = APPEND(fn_names, operand);
                fn_params = APPEND(fn_params, meta_value(row[4], "params"));
                // Declared return type; `Array` without a parameter stays "arr"
                // and is refined at end_fn from what the body actually returns.
                fn_types = APPEND(fn_types, type_norm(meta_value(row[4], "ret")));
                fn_labels = APPEND(fn_labels, ".Lfn_" + sanitize(operand) + "_" + TO_STRING(LEN(fn_names)));
            }
            let is_var = false;
            if op == 2 {
                is_var = true;
            }
            if op == 3 {
                is_var = true;
            }
            if is_var {
                if index_of(slot_names, operand) == LEN(slot_names) {
                    slot_names = APPEND(slot_names, operand);
                }
            }
        }
        i = i + 1;
    }

    // --- register assignment ------------------------------------------------
    // The most frequently referenced variables stay in callee-saved registers
    // for the whole function, so their loads/stores are register moves.
    let regs = [];
    let hot_slots = [];
    let assign = reg_assignment(rows, slot_names);
    regs = assign[0];
    hot_slots = assign[1];
    let h = 0;
    while h < LEN(hot_slots) {
        let hs = hot_slots[h];
        out = APPEND(out, "  mov " + regs[hs] + ", qword ptr [rbp - " + TO_STRING(200 + hs * 8) + "]");
        report = APPEND(report, "STAT reg " + slot_names[hs] + " -> " + regs[hs]);
        h = h + 1;
    }

    // --- emit ---------------------------------------------------------------
    let sp = 0;
    let max_sp = 0;
    let types = [];
    let str_pool = [];
    // Fractional literals, kept in source order: `.LF<n>` in .rodata holds the
    // assembler-parsed double, so no float arithmetic is needed to load one.
    let float_pool = [];
    let fn_cursor = 0;
    let ret_seen = "";
    let i = 0;
    while i < LEN(rows) {
        let row = rows[i];
        if row[0] == "LABEL" {
            let fastf = fast_vec_filtered_square(rows, i, regs, slot_names);
            if LEN(fastf) > 0 {
                let fi = 0;
                while fi < LEN(fastf) {
                    out = APPEND(out, fastf[fi]);
                    fi = fi + 1;
                }
                report = APPEND(report, "VECTORIZED filtered-square-loop " + row[1] + " 8-wide-avx2");
                i = i + 29;
                continue;
            }
            let fasta = fast_vec_array_axpy(rows, i, regs, slot_names);
            if LEN(fasta) > 0 {
                let ai = 0;
                while ai < LEN(fasta) {
                    out = APPEND(out, fasta[ai]);
                    ai = ai + 1;
                }
                report = APPEND(report, "VECTORIZED array-map-loop " + row[1] + " 8-wide-avx2");
                i = i + 22;
                continue;
            }
            let fastl = fast_vec_array_fill(rows, i, regs, slot_names);
            if LEN(fastl) > 0 {
                let li = 0;
                while li < LEN(fastl) {
                    out = APPEND(out, fastl[li]);
                    li = li + 1;
                }
                report = APPEND(report, "VECTORIZED array-fill-loop " + row[1] + " 4-wide-avx2");
                i = i + 22;
                continue;
            }
            let fastv = fast_vec_reduce(rows, i, regs, slot_names);
            if LEN(fastv) > 0 {
                let vi = 0;
                while vi < LEN(fastv) {
                    out = APPEND(out, fastv[vi]);
                    vi = vi + 1;
                }
                report = APPEND(report, "VECTORIZED reduction-loop " + row[1] + " 8-wide-avx2");
                i = i + 14;
                continue;
            }
            out = APPEND(out, ".L" + row[1] + ":");
        } else {
            let fastr = fast_rem_branch(rows, i, regs, slot_names);
            if LEN(fastr) > 0 {
                out = APPEND(out, fastr[0]);
                out = APPEND(out, fastr[1]);
                report = APPEND(report, "LOWERED rem-pow2-branch span=" + fastr[2]);
                i = i + TO_NUMBER(fastr[2]);
                continue;
            }
            let fastm = fast_mod_branch(rows, i, regs, slot_names);
            if LEN(fastm) > 0 {
                out = APPEND(out, fastm[0]);
                out = APPEND(out, fastm[1]);
                report = APPEND(report, "LOWERED mod-pow2-branch");
                i = i + 6;
                continue;
            }
            let fastf = fast_mul_add(rows, i, regs, slot_names);
            if LEN(fastf) > 0 {
                let q = 0;
                while q < LEN(fastf) {
                    out = APPEND(out, fastf[q]);
                    q = q + 1;
                }
                report = APPEND(report, "LOWERED fused-mul-add");
                i = i + 6;
                continue;
            }
            let fast = fast_pattern(rows, i, regs, slot_names);
            let fastx = [];
            if LEN(fast) == 0 {
                fastx = fast_partial(rows, i, regs, slot_names, sp);
            }
            if LEN(fastx) > 0 {
                let g = 0;
                while g < LEN(fastx) {
                    out = APPEND(out, fastx[g]);
                    g = g + 1;
                }
                report = APPEND(report, "LOWERED reg-partial");
                i = i + 3;
                sp = sp + 1;
                types = APPEND(types, "int");
                continue;
            }
            if LEN(fast) > 0 {
                let f = 0;
                while f < LEN(fast) {
                    out = APPEND(out, fast[f]);
                    f = f + 1;
                }
                report = APPEND(report, "LOWERED reg-op");
                i = i + 4;
                continue;
            }
            let op = row[1];
            let operand = row[2];
            let meta = row[4];

            if op == 1 {
                // The emitter tags bool literals; a bare `true` operand is the
                // string literal "true".
                let is_bool = has_meta(meta, "bool");
                let is_str = has_meta(meta, "str");
                let is_float = has_meta(meta, "float");
                if is_bool {
                    // Boolean literals: 1/0 in memory, tagged `bool` so print
                    // picks the true/false formatting the VM uses. The emitter
                    // writes the word, but accept 0/1 too so older IR still runs.
                    let bv = "0";
                    if operand == "true" || operand == "1" {
                        bv = "1";
                    }
                    out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + sp * 8) + "], " + bv);
                    types = APPEND(types, "bool");
                } else {
                    let numeric = looks_numeric(operand);
                    if is_str {
                        numeric = false;
                    }
                    // `NOTHING` is the source-level null literal. Keep its
                    // textual spelling but mark the slot as null so the
                    // null-safety guards can test it without comparing strings.
                    if operand == "NOTHING" {
                        numeric = false;
                    }
                    if numeric {
                        if is_float {
                            // A fractional literal is a double: load it from a
                            // .double in .rodata and keep the raw bits in the
                            // slot. `mov qword, 3.5` would not even assemble.
                            let fid = index_of(float_pool, operand);
                            if fid == LEN(float_pool) {
                                float_pool = APPEND(float_pool, operand);
                                fid = LEN(float_pool) - 1;
                            }
                            out = APPEND(out, "  movsd xmm0, qword ptr [rip + .LF" + TO_STRING(fid) + "]");
                            out = APPEND(out, "  movq rax, xmm0");
                            out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + sp * 8) + "], rax");
                            types = APPEND(types, "float");
                        } else {
                            out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + sp * 8) + "], " + operand);
                            types = APPEND(types, "int");
                        }
                    } else {
                        let literal = ir_unescape(operand);
                        let sid = index_of(str_pool, literal);
                        if sid == LEN(str_pool) {
                            str_pool = APPEND(str_pool, literal);
                            sid = LEN(str_pool) - 1;
                        }
                        if operand == "NOTHING" {
                            out = APPEND(out, "  lea rax, [rip + .Lnull]");
                            out = APPEND(out, "  bts rax, 62");
                            out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + sp * 8) + "], rax");
                            types = APPEND(types, "null");
                        } else {
                            out = APPEND(out, "  lea rax, [rip + .LS" + TO_STRING(sid) + "]");
                            out = APPEND(out, "  bts rax, 62");
                            out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + sp * 8) + "], rax");
                            types = APPEND(types, "str");
                        }
                    }
                }
                sp = sp + 1;
            }

            if op == 2 {
                let sidx = index_of(slot_names, operand);
                if sidx == LEN(slot_names) {
                    out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + sp * 8) + "], 0");
                    types = APPEND(types, "int");
                } else {
                    if sidx < LEN(regs) {
                        if regs[sidx] != "" {
                            out = APPEND(out, "  mov rax, " + regs[sidx]);
                        } else {
                            out = APPEND(out, "  mov rax, qword ptr [rbp - " + TO_STRING(200 + sidx * 8) + "]");
                        }
                    } else {
                        out = APPEND(out, "  mov rax, qword ptr [rbp - " + TO_STRING(200 + sidx * 8) + "]");
                    }
                    out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + sp * 8) + "], rax");
                    let t = "any";
                    if sidx < LEN(var_types) {
                        if LEN(var_types[sidx]) > 0 {
                            t = var_types[sidx];
                        }
                    }
                    types = APPEND(types, t);
                }
                sp = sp + 1;
            }

            if op == 3 {
                let sidx = index_of(slot_names, operand);
                let t = "any";
                if LEN(types) > 0 {
                    t = types[LEN(types) - 1];
                    types = drop_last(types);
                }
                out = APPEND(out, "  mov rax, qword ptr [rbp - " + TO_STRING(4096 + (sp - 1) * 8) + "]");
                if sidx < LEN(regs) {
                    if regs[sidx] != "" {
                        out = APPEND(out, "  mov " + regs[sidx] + ", rax");
                    } else {
                        out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(200 + sidx * 8) + "], rax");
                    }
                } else {
                    out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(200 + sidx * 8) + "], rax");
                }
                while LEN(var_types) <= sidx {
                    var_types = APPEND(var_types, "any");
                }
                var_types = replace_at(var_types, sidx, t);
                sp = sp - 1;
            }

            if op == 10 {
                let add_any = false;
                let add_float = has_float(types, sp);
                if add_float {
                    report = APPEND(report, "FALLBACK 10 float-arith-not-in-this-stage");
                    out = APPEND(out, "  call null_unsupported");
                    types = drop_last(types);
                    sp = sp - 1;
                } else {
                if type_at(types, sp - 2) == "any" || type_at(types, sp - 1) == "any" {
                    add_any = true;
                }
                let add_str = false;
                if add_any == false {
                    if LEN(types) >= 2 {
                        if types[LEN(types) - 2] == "str" {
                            if types[LEN(types) - 1] == "str" {
                                add_str = true;
                            }
                        }
                    }
                }
                if add_any {
                    out = APPEND(out, "  mov rdi, qword ptr [rbp - " + TO_STRING(4096 + (sp - 2) * 8) + "]");
                    out = APPEND(out, "  mov rsi, qword ptr [rbp - " + TO_STRING(4096 + (sp - 1) * 8) + "]");
                    out = APPEND(out, "  call null_dyn_add");
                    out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + (sp - 2) * 8) + "], rax");
                    types = drop_last(types);
                    types = set_top(types, "any");
                    sp = sp - 1;
                    report = APPEND(report, "LOWERED 10 dyn-add");
                } else {
                if add_str {
                    out = APPEND(out, "  mov rdi, qword ptr [rbp - " + TO_STRING(4096 + (sp - 2) * 8) + "]");
                    out = APPEND(out, "  mov rsi, qword ptr [rbp - " + TO_STRING(4096 + (sp - 1) * 8) + "]");
                    out = APPEND(out, "  call null_str_concat");
                    out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + (sp - 2) * 8) + "], rax");
                    types = drop_last(types);
                    types = drop_last(types);
                    types = APPEND(types, "str");
                    sp = sp - 1;
                    report = APPEND(report, "LOWERED 10 str-concat");
                } else {
                    out = APPEND(out, "  mov rax, qword ptr [rbp - " + TO_STRING(4096 + (sp - 1) * 8) + "]");
                    out = APPEND(out, "  add qword ptr [rbp - " + TO_STRING(4096 + (sp - 2) * 8) + "], rax");
                    types = drop_last(types);
                    sp = sp - 1;
                }
                }
                }
            }
            if op == 11 {
                if has_float(types, sp) {
                    report = APPEND(report, "FALLBACK 11 float-arith-not-in-this-stage");
                    out = APPEND(out, "  call null_unsupported");
                    types = drop_last(types);
                    sp = sp - 1;
                } else {
                out = APPEND(out, "  mov rax, qword ptr [rbp - " + TO_STRING(4096 + (sp - 1) * 8) + "]");
                out = APPEND(out, "  sub qword ptr [rbp - " + TO_STRING(4096 + (sp - 2) * 8) + "], rax");
                types = drop_last(types);
                sp = sp - 1;
                }
            }
            if op == 12 {
                if has_float(types, sp) {
                    report = APPEND(report, "FALLBACK 12 float-arith-not-in-this-stage");
                    out = APPEND(out, "  call null_unsupported");
                    types = drop_last(types);
                    sp = sp - 1;
                } else {
                out = APPEND(out, "  mov rax, qword ptr [rbp - " + TO_STRING(4096 + (sp - 1) * 8) + "]");
                out = APPEND(out, "  imul rax, qword ptr [rbp - " + TO_STRING(4096 + (sp - 2) * 8) + "]");
                out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + (sp - 2) * 8) + "], rax");
                types = drop_last(types);
                sp = sp - 1;
                }
            }
            if op == 13 {
                if has_float(types, sp) {
                    report = APPEND(report, "FALLBACK 13 float-arith-not-in-this-stage");
                    out = APPEND(out, "  call null_unsupported");
                    types = drop_last(types);
                    sp = sp - 1;
                } else {
                out = APPEND(out, "  mov rax, qword ptr [rbp - " + TO_STRING(4096 + (sp - 2) * 8) + "]");
                out = APPEND(out, "  cmp qword ptr [rbp - " + TO_STRING(4096 + (sp - 1) * 8) + "], 0");
                out = APPEND(out, "  je .Ldivzero_" + TO_STRING(i));
                out = APPEND(out, "  cqo");
                out = APPEND(out, "  idiv qword ptr [rbp - " + TO_STRING(4096 + (sp - 1) * 8) + "]");
                out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + (sp - 2) * 8) + "], rax");
                out = APPEND(out, ".Ldivok_" + TO_STRING(i) + ":");
                types = drop_last(types);
                sp = sp - 1;
                }
            }

            if op == 20 {
                out = cat(out, cmp_sequence("setg", sp));
                types = drop_last(types);
                types = set_top(types, "bool");
                sp = sp - 1;
            }
            if op == 21 {
                out = cat(out, cmp_sequence("setl", sp));
                types = drop_last(types);
                types = set_top(types, "bool");
                sp = sp - 1;
            }
            if op == 22 {
                let eq_any = false;
                if type_at(types, sp - 2) == "any" || type_at(types, sp - 1) == "any" {
                    eq_any = true;
                }
                if eq_any {
                    out = APPEND(out, "  mov rdi, qword ptr [rbp - " + TO_STRING(4096 + (sp - 2) * 8) + "]");
                    out = APPEND(out, "  mov rsi, qword ptr [rbp - " + TO_STRING(4096 + (sp - 1) * 8) + "]");
                    out = APPEND(out, "  call null_dyn_eq");
                    out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + (sp - 2) * 8) + "], rax");
                    types = drop_last(types);
                    types = drop_last(types);
                    types = APPEND(types, "bool");
                    sp = sp - 1;
                    report = APPEND(report, "LOWERED 22 dyn-eq");
                } else {
                if str_pair(types) {
                    out = APPEND(out, "  mov rdi, qword ptr [rbp - " + TO_STRING(4096 + (sp - 2) * 8) + "]");
                    out = APPEND(out, "  mov rsi, qword ptr [rbp - " + TO_STRING(4096 + (sp - 1) * 8) + "]");
                    out = APPEND(out, "  call null_str_eq");
                    out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + (sp - 2) * 8) + "], rax");
                    types = drop_last(types);
                    types = drop_last(types);
                    types = APPEND(types, "bool");
                    sp = sp - 1;
                    report = APPEND(report, "LOWERED 22 str-eq");
                } else {
                    out = cat(out, cmp_sequence("sete", sp));
                    types = drop_last(types);
                    types = set_top(types, "bool");
                    sp = sp - 1;
                }
                }
            }
            if op == 23 {
                let ne_any = false;
                if type_at(types, sp - 2) == "any" || type_at(types, sp - 1) == "any" {
                    ne_any = true;
                }
                if ne_any {
                    out = APPEND(out, "  mov rdi, qword ptr [rbp - " + TO_STRING(4096 + (sp - 2) * 8) + "]");
                    out = APPEND(out, "  mov rsi, qword ptr [rbp - " + TO_STRING(4096 + (sp - 1) * 8) + "]");
                    out = APPEND(out, "  call null_dyn_eq");
                    out = APPEND(out, "  xor rax, 1");
                    out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + (sp - 2) * 8) + "], rax");
                    types = drop_last(types);
                    types = drop_last(types);
                    types = APPEND(types, "bool");
                    sp = sp - 1;
                    report = APPEND(report, "LOWERED 23 dyn-ne");
                } else {
                if str_pair(types) {
                    out = APPEND(out, "  mov rdi, qword ptr [rbp - " + TO_STRING(4096 + (sp - 2) * 8) + "]");
                    out = APPEND(out, "  mov rsi, qword ptr [rbp - " + TO_STRING(4096 + (sp - 1) * 8) + "]");
                    out = APPEND(out, "  call null_str_eq");
                    out = APPEND(out, "  xor rax, 1");
                    out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + (sp - 2) * 8) + "], rax");
                    types = drop_last(types);
                    types = drop_last(types);
                    types = APPEND(types, "bool");
                    sp = sp - 1;
                    report = APPEND(report, "LOWERED 23 str-ne");
                } else {
                    out = cat(out, cmp_sequence("setne", sp));
                    types = drop_last(types);
                    types = set_top(types, "bool");
                    sp = sp - 1;
                }
                }
            }
            if op == 24 {
                out = cat(out, cmp_sequence("setge", sp));
                types = drop_last(types);
                types = set_top(types, "bool");
                sp = sp - 1;
            }
            if op == 25 {
                out = cat(out, cmp_sequence("setle", sp));
                types = drop_last(types);
                types = set_top(types, "bool");
                sp = sp - 1;
            }

            // Logical and/or: both operands are coerced to a bool, so an `any`
            // operand goes through null_truthy rather than being read as an int.
            if op == 26 {
                out = cat(out, logic_sequence("and", types, sp));
                types = drop_last(types);
                types = drop_last(types);
                types = APPEND(types, "bool");
                sp = sp - 1;
                report = APPEND(report, "LOWERED 26 and");
            }
            if op == 27 {
                out = cat(out, logic_sequence("or", types, sp));
                types = drop_last(types);
                types = drop_last(types);
                types = APPEND(types, "bool");
                sp = sp - 1;
                report = APPEND(report, "LOWERED 27 or");
            }

            if op == 30 {
                let t = "int";
                if LEN(types) > 0 {
                    t = types[LEN(types) - 1];
                }
                out = APPEND(out, "  mov rdi, qword ptr [rbp - " + TO_STRING(4096 + (sp - 1) * 8) + "]");
                if t == "any" {
                    out = APPEND(out, "  call null_dyn_print");
                    report = APPEND(report, "LOWERED 30 dyn-print");
                } else {
                    if t == "null" {
                        out = APPEND(out, "  call null_print_str");
                    } else {
                    if t == "str" {
                        out = APPEND(out, "  call null_print_str");
                    } else {
                        if t == "bool" {
                            out = APPEND(out, "  call null_print_bool");
                        } else {
                        if t == "float" {
                            out = APPEND(out, "  call null_print_f64");
                        } else {
                            out = APPEND(out, "  call null_print_i64");
                        }
                        }
                    }
                    }
                }
                types = drop_last(types);
                sp = sp - 1;
            }

            if op == 40 {
                out = APPEND(out, "  cmp qword ptr [rbp - " + TO_STRING(4096 + (sp - 1) * 8) + "], 0");
                out = APPEND(out, "  je .L" + operand);
                types = drop_last(types);
                sp = sp - 1;
            }
            if op == 41 {
                out = APPEND(out, "  jmp .L" + operand);
            }

            // Null-safety guards. Both operands are already on the stack: the
            // emitter pushes the left value, then the fallback, then the guard
            // opcode. Each guard leaves exactly one value behind.
            if op == 60 {
                // Safe access. The emitter leaves only the object on the stack
                // because there is no object member table in this stage. A
                // null object stays null; a non-null object is returned
                // unchanged rather than fabricating a member value.
                let base = 4096 + (sp - 1) * 8;
                out = APPEND(out, "  mov rax, qword ptr [rbp - " + TO_STRING(base) + "]");
                out = APPEND(out, "  and rax, qword ptr [rip + .Lmask]");
                out = APPEND(out, "  lea rdx, [rip + .Lnull]");
                out = APPEND(out, "  cmp rax, rdx");
                out = APPEND(out, "  je .Lnull60_" + TO_STRING(i));
                out = APPEND(out, "  cmp qword ptr [rbp - " + TO_STRING(base) + "], 0");
                out = APPEND(out, "  jne .Lend60_" + TO_STRING(i));
                out = APPEND(out, ".Lnull60_" + TO_STRING(i) + ":");
                out = APPEND(out, "  lea rax, [rip + .Lnull]");
                out = APPEND(out, "  bts rax, 62");
                out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(base) + "], rax");
                out = APPEND(out, ".Lend60_" + TO_STRING(i) + ":");
                types = set_top(types, "null");
                report = APPEND(report, "LOWERED 60 safe-access");
            }
            if op == 61 {
                // Elvis: keep the left value when it is truthy, otherwise take
                // the fallback. `null_truthy` implements the same rules as the
                // VM (0, false, empty string and null are falsy).
                let base = 4096 + (sp - 2) * 8;
                out = APPEND(out, "  mov rdi, qword ptr [rbp - " + TO_STRING(base) + "]");
                out = APPEND(out, "  call null_truthy");
                out = APPEND(out, "  test rax, rax");
                out = APPEND(out, "  jne .Lkeep61_" + TO_STRING(i));
                out = APPEND(out, "  mov rax, qword ptr [rbp - " + TO_STRING(4096 + (sp - 1) * 8) + "]");
                out = APPEND(out, "  jmp .Lend61_" + TO_STRING(i));
                out = APPEND(out, ".Lkeep61_" + TO_STRING(i) + ":");
                out = APPEND(out, "  mov rax, qword ptr [rbp - " + TO_STRING(base) + "]");
                out = APPEND(out, ".Lend61_" + TO_STRING(i) + ":");
                out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(base) + "], rax");
                let left_type = type_at(types, sp - 2);
                let right_type = type_at(types, sp - 1);
                types = drop_last(types);
                types = drop_last(types);
                // The branch can select either operand, so a differing static
                // type would make the later print read the wrong representation.
                let result_type = right_type;
                if left_type != right_type {
                    result_type = "any";
                }
                types = APPEND(types, result_type);
                sp = sp - 1;
                report = APPEND(report, "LOWERED 61 elvis");
            }
            if op == 62 {
                // Not-null assertion: a null value is a runtime error rather
                // than a silent pass-through.
                let base = 4096 + (sp - 1) * 8;
                out = APPEND(out, "  mov rax, qword ptr [rbp - " + TO_STRING(base) + "]");
                out = APPEND(out, "  and rax, qword ptr [rip + .Lmask]");
                out = APPEND(out, "  lea rdx, [rip + .Lnull]");
                out = APPEND(out, "  cmp rax, rdx");
                out = APPEND(out, "  je .Lnotnull_fail_" + TO_STRING(i));
                out = APPEND(out, "  jmp .Lnotnull_ok_" + TO_STRING(i));
                out = APPEND(out, ".Lnotnull_fail_" + TO_STRING(i) + ":");
                out = APPEND(out, "  mov rax, 1");
                out = APPEND(out, "  mov rdi, 2");
                out = APPEND(out, "  lea rsi, [rip + .Lnotnull]");
                out = APPEND(out, "  mov rdx, 25");
                out = APPEND(out, "  syscall");
                out = APPEND(out, "  mov rax, 60");
                out = APPEND(out, "  xor rdi, rdi");
                out = APPEND(out, "  syscall");
                out = APPEND(out, ".Lnotnull_ok_" + TO_STRING(i) + ":");
                report = APPEND(report, "LOWERED 62 not-null");
            }

            if op == 70 {
                let argc_text = meta_value(meta, "arity");
                let argc = 0;
                if LEN(argc_text) > 0 {
                    argc = TO_NUMBER(argc_text);
                }
                let base = sp - argc;
                let name = operand;
                if name == "LEN" {
                    name = "len";
                }
                if name == "MOD" {
                    name = "mod";
                }
                if name == "NEG" {
                    name = "neg";
                }
                if name == "CONCAT" {
                    name = "concat";
                }
                if name == "CHAR_AT" {
                    name = "char_at";
                }
                if name == "ORD" {
                    name = "ord";
                }
                if name == "READ_FILE" {
                    name = "read_file";
                }
                if name == "SPLIT" {
                    name = "split";
                }
                if name == "JOIN" {
                    name = "join";
                }
                if name == "SUBSTR" {
                    name = "substr";
                }
                if name == "TO_STRING" {
                    name = "to_string";
                }
                if name == "TO_NUMBER" {
                    name = "to_number";
                }
                if name == "WRITE_FILE" {
                    name = "write_file";
                }
                if name == "FILE_EXISTS" {
                    name = "file_exists";
                }
                if name == "ARGC" {
                    name = "argc";
                }
                if name == "ARGV" {
                    name = "argv";
                }
                if name == "SHELL" {
                    name = "shell";
                }
                if name == "SLICE" {
                    name = "slice";
                }
                if name == "CONTAINS" {
                    name = "contains";
                }
                let builtin = false;
                if name == "len" {
                    builtin = true;
                    if type_at(types, base) == "any" {
                        out = APPEND(out, "  mov rdi, qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "]");
                        out = APPEND(out, "  call null_dyn_len");
                        out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "], rax");
                        report = APPEND(report, "LOWERED 70 len-dynamic");
                    } else {
                    if type_at(types, base) == "str" {
                        out = APPEND(out, "  mov rdi, qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "]");
                        out = APPEND(out, "  call null_str_len");
                        out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "], rax");
                        report = APPEND(report, "LOWERED 70 len-string");
                    } else {
                        out = APPEND(out, "  mov rax, qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "]");
                        out = APPEND(out, "  and rax, qword ptr [rip + .Lmask]");
                        out = APPEND(out, "  mov rax, qword ptr [rax]");
                        out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "], rax");
                        report = APPEND(report, "LOWERED 70 len-array-header");
                    }
                    }
                    sp = base + 1;
                    types = drop_last(types);
                    types = APPEND(types, "int");
                }
                if name == "char_at" {
                    builtin = true;
                    out = APPEND(out, "  mov rdi, qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "]");
                    out = APPEND(out, "  mov rsi, qword ptr [rbp - " + TO_STRING(4096 + (base + 1) * 8) + "]");
                    out = APPEND(out, "  call null_str_char_at");
                    out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "], rax");
                    report = APPEND(report, "LOWERED 70 char_at");
                    types = drop_last(types);
                    types = drop_last(types);
                    types = APPEND(types, "str");
                    sp = base + 1;
                }
                if name == "ord" {
                    builtin = true;
                    out = APPEND(out, "  mov rdi, qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "]");
                    out = APPEND(out, "  call null_str_ord");
                    out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "], rax");
                    report = APPEND(report, "LOWERED 70 ord");
                    types = drop_last(types);
                    types = APPEND(types, "int");
                    sp = base + 1;
                }
                if name == "read_file" {
                    builtin = true;
                    out = APPEND(out, "  mov rdi, qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "]");
                    out = APPEND(out, "  call null_read_file");
                    out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "], rax");
                    report = APPEND(report, "LOWERED 70 read_file");
                    types = drop_last(types);
                    types = APPEND(types, "str");
                    sp = base + 1;
                }
                if name == "split" {
                    builtin = true;
                    out = APPEND(out, "  mov rdi, qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "]");
                    out = APPEND(out, "  mov rsi, qword ptr [rbp - " + TO_STRING(4096 + (base + 1) * 8) + "]");
                    out = APPEND(out, "  call null_str_split");
                    out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "], rax");
                    report = APPEND(report, "LOWERED 70 split");
                    sp = base + 1;
                    types = drop_last(types);
                    types = drop_last(types);
                    types = APPEND(types, "arr:str");
                }
                if name == "join" {
                    builtin = true;
                    out = APPEND(out, "  mov rdi, qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "]");
                    out = APPEND(out, "  mov rsi, qword ptr [rbp - " + TO_STRING(4096 + (base + 1) * 8) + "]");
                    out = APPEND(out, "  call null_str_join");
                    out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "], rax");
                    report = APPEND(report, "LOWERED 70 join");
                    sp = base + 1;
                    types = drop_last(types);
                    types = drop_last(types);
                    types = APPEND(types, "str");
                }
                if name == "substr" {
                    builtin = true;
                    out = APPEND(out, "  mov rdi, qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "]");
                    out = APPEND(out, "  mov rsi, qword ptr [rbp - " + TO_STRING(4096 + (base + 1) * 8) + "]");
                    out = APPEND(out, "  mov rdx, qword ptr [rbp - " + TO_STRING(4096 + (base + 2) * 8) + "]");
                    out = APPEND(out, "  call null_str_substr");
                    out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "], rax");
                    report = APPEND(report, "LOWERED 70 substr");
                    sp = base + 1;
                    types = drop_last(types);
                    types = drop_last(types);
                    types = drop_last(types);
                    types = APPEND(types, "str");
                }
                if name == "to_string" {
                    builtin = true;
                    let st = type_at(types, base);
                    if st == "any" {
                        out = APPEND(out, "  mov rdi, qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "]");
                        out = APPEND(out, "  call null_dyn_to_string");
                        out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "], rax");
                        report = APPEND(report, "LOWERED 70 to_string-dynamic");
                    } else {
                    if st == "str" {
                        report = APPEND(report, "LOWERED 70 to_string-identity");
                    } else {
                        out = APPEND(out, "  mov rdi, qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "]");
                        if st == "bool" {
                            // Booleans become the same true/false text print uses.
                            out = APPEND(out, "  test rdi, rdi");
                            out = APPEND(out, "  jz .Lts_f" + TO_STRING(i));
                            out = APPEND(out, "  lea rax, [rip + .Ltrue]");
                            out = APPEND(out, "  jmp .Lts_d" + TO_STRING(i));
                            out = APPEND(out, ".Lts_f" + TO_STRING(i) + ":");
                            out = APPEND(out, "  lea rax, [rip + .Lfalse]");
                            out = APPEND(out, ".Lts_d" + TO_STRING(i) + ":");
                        } else {
                            out = APPEND(out, "  call null_int_to_str");
                        }
                        out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "], rax");
                        report = APPEND(report, "LOWERED 70 to_string");
                    }
                    }
                    sp = base + 1;
                    types = drop_last(types);
                    types = APPEND(types, "str");
                }
                if name == "to_number" {
                    builtin = true;
                    out = APPEND(out, "  mov rdi, qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "]");
                    out = APPEND(out, "  call null_str_to_number");
                    out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "], rax");
                    report = APPEND(report, "LOWERED 70 to_number");
                    sp = base + 1;
                    types = drop_last(types);
                    types = APPEND(types, "int");
                }
                if name == "write_file" {
                    builtin = true;
                    out = APPEND(out, "  mov rdi, qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "]");
                    out = APPEND(out, "  mov rsi, qword ptr [rbp - " + TO_STRING(4096 + (base + 1) * 8) + "]");
                    out = APPEND(out, "  call null_write_file");
                    out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "], rax");
                    report = APPEND(report, "LOWERED 70 write_file");
                    sp = base + 1;
                    types = drop_last(types);
                    types = drop_last(types);
                    types = APPEND(types, "int");
                }
                if name == "file_exists" {
                    builtin = true;
                    out = APPEND(out, "  mov rdi, qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "]");
                    out = APPEND(out, "  call null_file_exists");
                    out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "], rax");
                    report = APPEND(report, "LOWERED 70 file_exists");
                    sp = base + 1;
                    types = drop_last(types);
                    types = APPEND(types, "bool");
                }
                if name == "shell" {
                    // Run a command through /bin/sh and yield its exit status.
                    // This is how a native driver invokes cc and the stages.
                    builtin = true;
                    out = APPEND(out, "  mov rdi, qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "]");
                    out = APPEND(out, "  call null_shell");
                    out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "], rax");
                    report = APPEND(report, "LOWERED 70 shell");
                    sp = base + 1;
                    types = drop_last(types);
                    types = APPEND(types, "int");
                }
                if name == "argc" {
                    // Process argument count, captured from main's edi.
                    builtin = true;
                    out = APPEND(out, "  mov rax, qword ptr [rip + .Largc]");
                    out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "], rax");
                    report = APPEND(report, "LOWERED 70 argc");
                    sp = base + 1;
                    types = APPEND(types, "int");
                }
                if name == "argv" {
                    // Process argument by index as a tagged C string. An index
                    // outside the captured range yields the empty string rather
                    // than reading past argv.
                    builtin = true;
                    out = APPEND(out, "  mov rcx, qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "]");
                    out = APPEND(out, "  xor eax, eax");
                    out = APPEND(out, "  cmp rcx, qword ptr [rip + .Largc]");
                    out = APPEND(out, "  jae .Largnone_" + TO_STRING(i));
                    out = APPEND(out, "  mov rax, qword ptr [rip + .Largv]");
                    out = APPEND(out, "  mov rax, qword ptr [rax + rcx * 8]");
                    out = APPEND(out, "  jmp .Largvout_" + TO_STRING(i));
                    out = APPEND(out, ".Largnone_" + TO_STRING(i) + ":");
                    out = APPEND(out, "  lea rax, [rip + .Lempty]");
                    out = APPEND(out, ".Largvout_" + TO_STRING(i) + ":");
                    out = APPEND(out, "  bts rax, 62");
                    out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "], rax");
                    report = APPEND(report, "LOWERED 70 argv");
                    sp = base + 1;
                    types = drop_last(types);
                    types = APPEND(types, "str");
                }
                if name == "slice" {
                    builtin = true;
                    let at = type_at(types, base);
                    out = APPEND(out, "  mov rdi, qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "]");
                    out = APPEND(out, "  mov rsi, qword ptr [rbp - " + TO_STRING(4096 + (base + 1) * 8) + "]");
                    out = APPEND(out, "  mov rdx, qword ptr [rbp - " + TO_STRING(4096 + (base + 2) * 8) + "]");
                    out = APPEND(out, "  call null_array_slice");
                    out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "], rax");
                    report = APPEND(report, "LOWERED 70 slice");
                    sp = base + 1;
                    types = drop_last(types);
                    types = drop_last(types);
                    types = drop_last(types);
                    if type_is_arr(at) {
                        types = APPEND(types, at);
                    } else {
                        types = APPEND(types, "arr");
                    }
                }
                if name == "contains" {
                    builtin = true;
                    out = APPEND(out, "  mov rdi, qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "]");
                    out = APPEND(out, "  mov rsi, qword ptr [rbp - " + TO_STRING(4096 + (base + 1) * 8) + "]");
                    out = APPEND(out, "  call null_contains");
                    out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "], rax");
                    report = APPEND(report, "LOWERED 70 contains");
                    sp = base + 1;
                    types = drop_last(types);
                    types = drop_last(types);
                    types = APPEND(types, "bool");
                }
                if name == "mod" {
                    builtin = true;
                    out = APPEND(out, "  mov rax, qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "]");
                    out = APPEND(out, "  cmp qword ptr [rbp - " + TO_STRING(4096 + (base + 1) * 8) + "], 0");
                    out = APPEND(out, "  je .Ldivzero_" + TO_STRING(i));
                    out = APPEND(out, "  cqo");
                    out = APPEND(out, "  idiv qword ptr [rbp - " + TO_STRING(4096 + (base + 1) * 8) + "]");
                    out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "], rdx");
                    out = APPEND(out, ".Ldivok_" + TO_STRING(i) + ":");
                    report = APPEND(report, "LOWERED 70 mod-idiv");
                    sp = base + 1;
                    types = drop_last(types);
                    types = drop_last(types);
                    types = APPEND(types, "int");
                }
                if name == "neg" {
                    builtin = true;
                    out = APPEND(out, "  neg qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "]");
                    report = APPEND(report, "LOWERED 70 neg");
                }
                if name == "set_index" {
                    // arr[idx] = value, bounds-checked: the write now exists in the
                    // language, so source programs can mutate an array literal.
                    builtin = true;
                    out = APPEND(out, "  mov rax, qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "]");
                    out = APPEND(out, "  and rax, qword ptr [rip + .Lmask]");
                    out = APPEND(out, "  mov rcx, qword ptr [rbp - " + TO_STRING(4096 + (base + 1) * 8) + "]");
                    out = APPEND(out, "  cmp rcx, qword ptr [rax]");
                    out = APPEND(out, "  jb .Lsetok_" + TO_STRING(i));
                    out = APPEND(out, "  call null_panic_oob");
                    out = APPEND(out, ".Lsetok_" + TO_STRING(i) + ":");
                    out = APPEND(out, "  mov rdx, qword ptr [rbp - " + TO_STRING(4096 + (base + 2) * 8) + "]");
                    out = APPEND(out, "  mov qword ptr [rax + rcx * 8 + 8], rdx");
                    // The op yields the array (the emitter follows it with STORE a
                    // for a plain `a[i] = x`), not the stored value.
                    out = APPEND(out, "  bts rax, 63");
                    out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "], rax");
                    types = drop_last(types);
                    types = drop_last(types);
                    types = drop_last(types);
                    types = APPEND(types, "arr");
                    sp = base + 1;
                    report = APPEND(report, "LOWERED 70 set-index-bounds-checked");
                }
                if name == "concat" {
                    builtin = true;
                    report = APPEND(report, "FALLBACK 70 concat-string-runtime-not-in-this-stage");
                    out = APPEND(out, "  call null_unsupported");
                }
                if name == "__range__" {
                    builtin = true;
                    report = APPEND(report, "FALLBACK 70 range-object-not-in-this-stage");
                    out = APPEND(out, "  call null_unsupported");
                }
                if name == "filter" {
                    builtin = true;
                    report = APPEND(report, "FALLBACK 70 filter-lambda-capture-not-in-this-stage");
                    out = APPEND(out, "  call null_unsupported");
                }
                if name == "map" {
                    builtin = true;
                    report = APPEND(report, "FALLBACK 70 map-lambda-capture-not-in-this-stage");
                    out = APPEND(out, "  call null_unsupported");
                }
                if builtin == false {
                    let fidx = index_of(fn_names, name);
                    if fidx == LEN(fn_names) {
                        report = APPEND(report, "FALLBACK 70 unknown-call-" + name);
                        out = APPEND(out, "  call null_unsupported");
                    } else {
                        // Not `regs`: let is function-scoped, and a local regs here
                        // would clobber the allocator's promoted-register table.
                        let arg_regs = ["rdi", "rsi", "rdx", "rcx", "r8", "r9"];
                        let a = 0;
                        while a < argc {
                            if a < 6 {
                                out = APPEND(out, "  mov " + arg_regs[a] + ", qword ptr [rbp - " + TO_STRING(4096 + (base + a) * 8) + "]");
                            }
                            a = a + 1;
                        }
                        out = APPEND(out, "  call " + fn_labels[fidx]);
                        out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "], rax");
                        let k = 0;
                        while k < argc {
                            types = drop_last(types);
                            k = k + 1;
                        }
                        // Declared return type of the callee (refined by its
                        // body for bare `Array`), so `f(x)[0]` and string
                        // returns keep their type through the call.
                        let rt = "any";
                        if fidx < LEN(fn_types) {
                            if LEN(fn_types[fidx]) > 0 {
                                rt = fn_types[fidx];
                            }
                        }
                        types = APPEND(types, rt);
                        sp = base + 1;
                        report = APPEND(report, "LOWERED 70 call-" + name);
                    }
                }
            }

            if op == 71 {
                if has_meta(meta, "unit") {
                    out = APPEND(out, "  xor eax, eax");
                } else {
                    out = APPEND(out, "  mov rax, qword ptr [rbp - " + TO_STRING(4096 + (sp - 1) * 8) + "]");
                    if LEN(types) > 0 {
                        ret_seen = types[LEN(types) - 1];
                    }
                    types = drop_last(types);
                    sp = sp - 1;
                }
                out = APPEND(out, "  leave");
                out = APPEND(out, "  ret");
            }

            if op == 72 {
                let argc_text = meta_value(meta, "arity");
                let argc = TO_NUMBER(argc_text);
                let base = sp - argc;
                out = APPEND(out, "  mov rdi, " + TO_STRING(argc));
                out = APPEND(out, "  call null_array_new");
                out = APPEND(out, "  mov qword ptr [rbp - 3000], rax");
                // The literal's element types, in order: `arr:str|int` for a
                // tuple, `arr:str|str` for a homogeneous list.
                //
                // The spec must be read before the store loop shrinks `types`:
                // reading it inside the loop dropped every element after the
                // first, so `["a", "b"][1]` was typed `""` (dynamic) and a
                // string element was printed as its tagged pointer.
                let spec = "";
                let e = 0;
                while e < argc {
                    if e > 0 {
                        spec = spec + "|";
                    }
                    spec = spec + type_at(types, base + e);
                    e = e + 1;
                }
                e = 0;
                while e < argc {
                    out = APPEND(out, "  mov rcx, qword ptr [rbp - " + TO_STRING(4096 + (base + e) * 8) + "]");
                    out = APPEND(out, "  mov qword ptr [rax + " + TO_STRING((e + 1) * 8) + "], rcx");
                    types = drop_last(types);
                    e = e + 1;
                }
                out = APPEND(out, "  mov rax, qword ptr [rbp - 3000]");
                out = APPEND(out, "  bts rax, 63");
                out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + base * 8) + "], rax");
                if LEN(spec) == 0 {
                    spec = "any";
                }
                types = APPEND(types, "arr:" + spec);
                sp = base + 1;
                report = APPEND(report, "LOWERED 72 array-literal");
            }

            if op == 73 {
                let btype = type_at(types, sp - 2);
                let idx_now = const_operand(rows, i);
                let use_dyn = false;
                if btype == "any" {
                    use_dyn = true;
                }
                if btype == "str" {
                    use_dyn = true;
                }
                if use_dyn {
                    out = APPEND(out, "  mov rdi, qword ptr [rbp - " + TO_STRING(4096 + (sp - 2) * 8) + "]");
                    out = APPEND(out, "  mov rsi, qword ptr [rbp - " + TO_STRING(4096 + (sp - 1) * 8) + "]");
                    out = APPEND(out, "  call null_dyn_index");
                    out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + (sp - 2) * 8) + "], rax");
                    types = drop_last(types);
                    types = drop_last(types);
                    types = APPEND(types, index_type(btype, idx_now));
                    sp = sp - 1;
                    report = APPEND(report, "LOWERED 73 dyn-index");
                } else {
                out = APPEND(out, "  mov rax, qword ptr [rbp - " + TO_STRING(4096 + (sp - 2) * 8) + "]");
                out = APPEND(out, "  and rax, qword ptr [rip + .Lmask]");
                out = APPEND(out, "  mov rcx, qword ptr [rbp - " + TO_STRING(4096 + (sp - 1) * 8) + "]");
                out = APPEND(out, "  cmp rcx, qword ptr [rax]");
                out = APPEND(out, "  jb .Lidx_ok_" + TO_STRING(i));
                out = APPEND(out, "  call null_panic_oob");
                out = APPEND(out, ".Lidx_ok_" + TO_STRING(i) + ":");
                out = APPEND(out, "  mov rax, qword ptr [rax + rcx * 8 + 8]");
                out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + (sp - 2) * 8) + "], rax");
                let atype = type_at(types, sp - 2);
                let idx_text = const_operand(rows, i);
                types = drop_last(types);
                types = drop_last(types);
                types = APPEND(types, index_type(atype, idx_text));
                sp = sp - 1;
                report = APPEND(report, "LOWERED 73 index-bounds-checked");
                }
            }

            if op == 74 {
                let params_text = meta_value(meta, "params");
                let params = [];
                if LEN(params_text) > 0 {
                    params = SPLIT(params_text, ",");
                }
                let types_text = meta_value(meta, "types");
                let ptypes = [];
                if LEN(types_text) > 0 {
                    ptypes = SPLIT(types_text, ",");
                }
                let label = fn_labels[fn_cursor];
                out = APPEND(out, "  jmp .Lfnskip_" + TO_STRING(fn_cursor));
                out = APPEND(out, label + ":");
                out = APPEND(out, "  push rbp");
                out = APPEND(out, "  mov rbp, rsp");
                out = APPEND(out, "  sub rsp, 16384");
                let arg_regs = ["rdi", "rsi", "rdx", "rcx", "r8", "r9"];
                let p = 0;
                while p < LEN(params) {
                    let sidx = index_of(slot_names, params[p]);
                    let pt = "";
                    if p < LEN(ptypes) {
                        pt = type_norm(ptypes[p]);
                    } else {
                        // No `types=` metadata (or a missing entry): the
                        // parameter is untyped, so its values are dynamic.
                        pt = "any";
                    }
                    // A parameter is in scope from the first instruction,
                    // before any store types it.
                    if LEN(pt) > 0 {
                        var_types = set_var_type(var_types, sidx, pt);
                    }
                    if p < 6 {
                        out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(200 + sidx * 8) + "], " + arg_regs[p]);
                    }
                    p = p + 1;
                }
                sp = 0;
                types = [];
                ret_seen = "";
                fn_cursor = fn_cursor + 1;
                report = APPEND(report, "LOWERED 74 function-" + operand);
            }

            // 255 covers HALT, end_fn, NOP and the ownership markers.
            if op == 255 {
                if operand == "end_fn" {
                    out = APPEND(out, "  xor eax, eax");
                    out = APPEND(out, "  leave");
                    out = APPEND(out, "  ret");
                    let skip = fn_cursor - 1;
                    if skip >= 0 {
                        if skip < LEN(fn_types) {
                            // A body returning an array tells the backend its
                            // element types even when the signature only says
                            // `-> Array` (or nothing).
                            if fn_types[skip] == "" || fn_types[skip] == "arr" || fn_types[skip] == "any" {
                                if LEN(ret_seen) > 0 {
                                    fn_types = replace_at(fn_types, skip, ret_seen);
                                }
                            }
                        }
                    }
                    out = APPEND(out, ".Lfnskip_" + TO_STRING(skip) + ":");
                    sp = 0;
                    types = [];
                }
                if operand == "HALT" {
                    out = APPEND(out, "  xor eax, eax");
                    out = APPEND(out, "  leave");
                    out = APPEND(out, "  ret");
                }
                if operand == "borrow" {
                    report = APPEND(report, "STAT 255 borrow-erased-at-compile-time");
                }
                if operand == "move" {
                    report = APPEND(report, "STAT 255 move-erased-at-compile-time");
                }
                // A row the front end could not lower is a compile error. It used
                // to fall through as a no-op, so `let y = ;` produced a binary
                // that ran with a missing value and exited 0.
                if starts_with(operand, "unsupported:") {
                    out = APPEND(out, "  call null_unsupported");
                    report = APPEND(report, "FALLBACK 255 " + operand);
                    report = APPEND(report, "ERROR " + operand);
                }
            }

            // --- specialised range ------------------------------------------
            if op == 100 {
                out = APPEND(out, "  mov rax, qword ptr [rbp - " + TO_STRING(4096 + (sp - 1) * 8) + "]");
                out = APPEND(out, "  add qword ptr [rbp - " + TO_STRING(4096 + (sp - 2) * 8) + "], rax");
                types = drop_last(types);
                sp = sp - 1;
                report = APPEND(report, "LOWERED 100 fast-add-int-no-tag-check");
            }
            if op == 101 {
                report = APPEND(report, "FALLBACK 101 fast-add-float-float64-not-in-this-stage");
                out = APPEND(out, "  call null_unsupported");
            }
            if op == 102 {
                out = cat(out, cmp_sequence("setl", sp));
                types = drop_last(types);
                types = set_top(types, "bool");
                sp = sp - 1;
                report = APPEND(report, "LOWERED 102 fast-lt-int");
            }
            if op == 103 {
                out = APPEND(out, "  mov rax, qword ptr [rbp - " + TO_STRING(4096 + (sp - 2) * 8) + "]");
                out = APPEND(out, "  and rax, qword ptr [rip + .Lmask]");
                out = APPEND(out, "  mov rcx, qword ptr [rbp - " + TO_STRING(4096 + (sp - 1) * 8) + "]");
                out = APPEND(out, "  mov rax, qword ptr [rax + rcx * 8 + 8]");
                out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + (sp - 2) * 8) + "], rax");
                let atype = type_at(types, sp - 2);
                let idx_text = const_operand(rows, i);
                types = drop_last(types);
                types = drop_last(types);
                types = APPEND(types, index_type(atype, idx_text));
                sp = sp - 1;
                report = APPEND(report, "LOWERED 103 fast-index-unchecked");
            }
            if op == 104 {
                out = APPEND(out, "  mov rax, qword ptr [rbp - " + TO_STRING(4096 + (sp - 1) * 8) + "]");
                out = APPEND(out, "  and rax, qword ptr [rip + .Lmask]");
                out = APPEND(out, "  mov rax, qword ptr [rax]");
                out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + (sp - 1) * 8) + "], rax");
                types = drop_last(types);
                types = APPEND(types, "int");
                report = APPEND(report, "LOWERED 104 fast-len-header");
            }
            if op == 105 {
                // FAST_INDEX_STORE: arr[idx] = value, bounds proven, in place.
                out = APPEND(out, "  mov rcx, qword ptr [rbp - " + TO_STRING(4096 + (sp - 3) * 8) + "]");
                out = APPEND(out, "  and rcx, qword ptr [rip + .Lmask]");
                out = APPEND(out, "  mov rdx, qword ptr [rbp - " + TO_STRING(4096 + (sp - 2) * 8) + "]");
                out = APPEND(out, "  mov rax, qword ptr [rbp - " + TO_STRING(4096 + (sp - 1) * 8) + "]");
                out = APPEND(out, "  mov qword ptr [rcx + rdx * 8 + 8], rax");
                out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + (sp - 3) * 8) + "], rcx");
                out = APPEND(out, "  bts qword ptr [rbp - " + TO_STRING(4096 + (sp - 3) * 8) + "], 63");
                types = drop_last(types);
                types = drop_last(types);
                types = drop_last(types);
                types = APPEND(types, "arr");
                sp = sp - 2;
                report = APPEND(report, "LOWERED 105 fast-index-store");
            }

            if op == 106 {
                // FAST_ARRAY_PUSH: pop the value and the array, append (growing in
                // place when the capacity is exhausted) and push the array back.
                // Growing can move the array, so the IR contract is a = APPEND(a, x).
                out = APPEND(out, "  mov rcx, qword ptr [rbp - " + TO_STRING(4096 + (sp - 2) * 8) + "]");
                out = APPEND(out, "  and rcx, qword ptr [rip + .Lmask]");
                out = APPEND(out, "  mov rax, qword ptr [rcx]");
                out = APPEND(out, "  cmp rax, qword ptr [rcx - 8]");
                out = APPEND(out, "  jl .Lpush_store_" + TO_STRING(i));
                out = APPEND(out, "  mov rdi, rcx");
                out = APPEND(out, "  call null_array_grow");
                out = APPEND(out, "  mov rcx, rax");
                out = APPEND(out, "  mov rax, qword ptr [rcx]");
                out = APPEND(out, ".Lpush_store_" + TO_STRING(i) + ":");
                out = APPEND(out, "  mov rdx, qword ptr [rbp - " + TO_STRING(4096 + (sp - 1) * 8) + "]");
                out = APPEND(out, "  mov qword ptr [rcx + rax * 8 + 8], rdx");
                out = APPEND(out, "  add rax, 1");
                out = APPEND(out, "  mov qword ptr [rcx], rax");
                out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + (sp - 2) * 8) + "], rcx");
                out = APPEND(out, "  bts qword ptr [rbp - " + TO_STRING(4096 + (sp - 2) * 8) + "], 63");
                types = drop_last(types);
                types = drop_last(types);
                types = APPEND(types, "arr");
                sp = sp - 1;
                report = APPEND(report, "LOWERED 106 fast-array-push");
            }

            if op == 107 {
                // FAST_ARRAY_ZERO: pop n, push a zeroed array of length n.
                out = APPEND(out, "  mov rdi, qword ptr [rbp - " + TO_STRING(4096 + (sp - 1) * 8) + "]");
                out = APPEND(out, "  call null_array_zero");
                out = APPEND(out, "  bts rax, 63");
                out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + (sp - 1) * 8) + "], rax");
                types = drop_last(types);
                types = APPEND(types, "arr");
                report = APPEND(report, "LOWERED 107 fast-array-zero");
            }

            if op == 110 {
                report = APPEND(report, "FALLBACK 110 fused-map-needs-captured-lambda");
                out = APPEND(out, "  call null_unsupported");
            }
            if op == 111 {
                report = APPEND(report, "FALLBACK 111 fused-filter-needs-captured-lambda");
                out = APPEND(out, "  call null_unsupported");
            }
            if op == 112 {
                report = APPEND(report, "FALLBACK 112 fused-reduce-needs-captured-lambda");
                out = APPEND(out, "  call null_unsupported");
            }
            if op == 122 {
                // SIMD_SUM: horizontal AVX2 reduction of an i64 array.
                out = APPEND(out, "  mov rdi, qword ptr [rbp - " + TO_STRING(4096 + (sp - 1) * 8) + "]");
                out = APPEND(out, "  call null_simd_sum");
                out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + (sp - 1) * 8) + "], rax");
                types = drop_last(types);
                types = APPEND(types, "int");
                report = APPEND(report, "LOWERED 122 simd-sum-avx2");
            }

            if op == 120 {
                out = APPEND(out, "  mov rdi, qword ptr [rbp - " + TO_STRING(4096 + (sp - 2) * 8) + "]");
                out = APPEND(out, "  mov rsi, qword ptr [rbp - " + TO_STRING(4096 + (sp - 1) * 8) + "]");
                out = APPEND(out, "  call null_simd_add");
                out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + (sp - 2) * 8) + "], rax");
                types = drop_last(types);
                types = drop_last(types);
                types = APPEND(types, "arr");
                sp = sp - 1;
                report = APPEND(report, "LOWERED 120 simd-add-avx2-vpaddq");
            }
            if op == 121 {
                out = APPEND(out, "  mov rdi, qword ptr [rbp - " + TO_STRING(4096 + (sp - 2) * 8) + "]");
                out = APPEND(out, "  mov rsi, qword ptr [rbp - " + TO_STRING(4096 + (sp - 1) * 8) + "]");
                out = APPEND(out, "  call null_simd_mul");
                out = APPEND(out, "  mov qword ptr [rbp - " + TO_STRING(4096 + (sp - 2) * 8) + "], rax");
                types = drop_last(types);
                types = drop_last(types);
                types = APPEND(types, "arr");
                sp = sp - 1;
                report = APPEND(report, "LOWERED 121 simd-mul-avx2-muludq");
            }
            if op == 113 {
                out = emit_comprehension(out, report, operand, sp, 4096, slot_names);
                // emit_comprehension reports its own line; fall back if bad.
                let parts = SPLIT(operand, "|");
                if LEN(parts) < 2 {
                    report = APPEND(report, "FALLBACK 113 malformed-comprehension");
                    out = APPEND(out, "  call null_unsupported");
                }
                sp = sp;
                types = drop_last(types);
                types = APPEND(types, "arr");
            }
            if op == 130 {
                report = APPEND(report, "FALLBACK 130 gpu-kernel-no-gpu-target-in-this-stage");
                out = APPEND(out, "  call null_unsupported");
            }
            if op == 140 {
                report = APPEND(report, "FALLBACK 140 dist-send-no-network-target-in-this-stage");
                out = APPEND(out, "  call null_unsupported");
            }
            if op == 141 {
                report = APPEND(report, "FALLBACK 141 dist-recv-no-network-target-in-this-stage");
                out = APPEND(out, "  call null_unsupported");
            }

            // Catch-all: an opcode this stage does not implement used to emit
            // no instructions at all and no report line, so a missing lowering
            // looked like working code. Every unimplemented opcode now traps.
            if op_is_lowered(op) == false {
                report = APPEND(report, "FALLBACK " + TO_STRING(op) + " opcode-not-lowered-in-this-stage");
                out = APPEND(out, "  call null_unsupported");
            }
        }
        if sp > max_sp {
            max_sp = sp;
        }
        i = i + 1;
    }
    report = APPEND(report, "STAT max-operand-sp " + TO_STRING(max_sp));

    out = APPEND(out, "");
    out = APPEND(out, ".section .rodata");
    out = APPEND(out, ".Lnl: .byte 10");
    out = APPEND(out, ".Lmask: .quad 0x3fffffffffffffff");
    out = APPEND(out, ".Larrtext: .asciz \"[array]\"");
    out = APPEND(out, ".Lnull: .asciz \"NOTHING\"");
    out = APPEND(out, ".bss");
    out = APPEND(out, ".align 8");
    out = APPEND(out, ".Largc: .quad 0");
    out = APPEND(out, ".Largv: .quad 0");
    out = APPEND(out, ".section .rodata");
    out = APPEND(out, ".Lnotnull: .ascii \"NOT NULL ASSERTION FAILED!!\\n\"");
    out = APPEND(out, ".Ltrue: .asciz \"true\"");
    out = APPEND(out, ".Lfalse: .asciz \"false\"");
    out = APPEND(out, ".Loob: .ascii \"OOB PANIC!!!\\n\"");
    out = APPEND(out, ".Ldivzero: .ascii \"DIVISION BY ZERO!!!\\n\"");
    out = APPEND(out, ".Lunsup: .ascii \"UNSUPPORTED OP!!\\n\"");
    out = APPEND(out, ".Lempty: .asciz \"\"");
    out = APPEND(out, ".Lsh: .asciz \"/bin/sh\"");
    out = APPEND(out, ".Lshc: .asciz \"-c\"");
    out = APPEND(out, ".Lf10: .double 10.0");
    out = APPEND(out, ".p2align 4");
    out = APPEND(out, ".Liota0: .quad 0, 1, 2, 3");
    out = APPEND(out, ".Lfour: .quad 4, 4, 4, 4");
    out = APPEND(out, ".Leight: .quad 8, 8, 8, 8");
    let s = 0;
    while s < LEN(str_pool) {
        out = APPEND(out, ".LS" + TO_STRING(s) + ": .asciz \"" + gas_literal(str_pool[s]) + "\"");
        s = s + 1;
    }
    let fp = 0;
    while fp < LEN(float_pool) {
        out = APPEND(out, ".LF" + TO_STRING(fp) + ": .double " + float_pool[fp]);
        fp = fp + 1;
    }

    // Peepholes over the emitted program: drop reloads of a value already in
    // rax, and fold compare + setCC + test into a single conditional jump.
    out = peephole(out);
    out = fuse_branches(out);
    out = redirect_divzero(out);
    out = add_epilogues(out);

    // Runtime helpers (print, allocation, bounds panic, AVX2 kernels).
    out = APPEND(out, "");
    out = APPEND(out, ".section .note.GNU-stack,\"\",@progbits");
    out = APPEND(out, ".text");
    out = cat(out, runtime_lines());
    return [out, report];
}

fn drop_last(list) -> Array {
    let out = [];
    let i = 0;
    while i < LEN(list) - 1 {
        out = APPEND(out, list[i]);
        i = i + 1;
    }
    return out;
}

fn replace_at(list, k: Num, value) -> Array {
    let out = [];
    let i = 0;
    while i < LEN(list) {
        if i == k {
            out = APPEND(out, value);
        } else {
            out = APPEND(out, list[i]);
        }
        i = i + 1;
    }
    return out;
}

fn logic_sequence(kind: Text, types, sp: Num) -> Array {
    let a = 4096 + (sp - 2) * 8;
    let b = 4096 + (sp - 1) * 8;
    let dyn = false;
    if type_at(types, sp - 2) == "any" || type_at(types, sp - 1) == "any" {
        dyn = true;
    }
    if dyn == false {
        return [
            "  mov rax, qword ptr [rbp - " + TO_STRING(a) + "]",
            "  test rax, rax",
            "  setne al",
            "  movzx rax, al",
            "  mov rdx, qword ptr [rbp - " + TO_STRING(b) + "]",
            "  test rdx, rdx",
            "  setne dl",
            "  movzx rdx, dl",
            "  " + kind + " rax, rdx",
            "  mov qword ptr [rbp - " + TO_STRING(a) + "], rax",
        ];
    }
    let right = "  or al, dl";
    if kind == "and" {
        right = "  and al, dl";
    }
    return [
        "  mov rdi, qword ptr [rbp - " + TO_STRING(a) + "]",
        "  call null_truthy",
        "  mov qword ptr [rbp - " + TO_STRING(a) + "], rax",
        "  mov rdi, qword ptr [rbp - " + TO_STRING(b) + "]",
        "  call null_truthy",
        "  mov rdx, rax",
        "  mov rax, qword ptr [rbp - " + TO_STRING(a) + "]",
        right,
        "  movzx rax, al",
        "  mov qword ptr [rbp - " + TO_STRING(a) + "], rax",
    ];
}

fn cmp_sequence(kind: Text, sp: Num) -> Array {
    let a = 4096 + (sp - 2) * 8;
    let b = 4096 + (sp - 1) * 8;
    return [
        "  mov rax, qword ptr [rbp - " + TO_STRING(b) + "]",
        "  cmp qword ptr [rbp - " + TO_STRING(a) + "], rax",
        "  " + kind + " al",
        "  movzx rax, al",
        "  mov qword ptr [rbp - " + TO_STRING(a) + "], rax",
    ];
}

fn emit_comprehension(out, report, operand: Text, sp: Num, base_off: Num, slot_names) -> Array {
    let parts = SPLIT(operand, "|");
    if LEN(parts) < 2 {
        return out;
    }
    let var_name = parts[0];
    let expr_tree = tree_from(parts[1]);
    let pred_tree = ["none"];
    if LEN(parts) > 2 {
        pred_tree = tree_from(parts[2]);
    }
    let bad = "";
    if tree_status(expr_tree) != "ok" {
        bad = "expression";
    }
    if tree_status(pred_tree) == "bad" {
        bad = "predicate";
    }
    if LEN(bad) > 0 {
        report = APPEND(report, "FALLBACK 113 unparsed-" + bad);
        return out;
    }
    let vslot = index_of(slot_names, var_name);
    let vofs = 200 + vslot * 8;
    let src = base_off + (sp - 1) * 8;
    let o = out;
    o = APPEND(o, "  mov rax, qword ptr [rbp - " + TO_STRING(src) + "]");
    o = APPEND(o, "  and rax, qword ptr [rip + .Lmask]");
    o = APPEND(o, "  mov rcx, qword ptr [rax]");
    o = APPEND(o, "  mov qword ptr [rbp - 9000], rcx");
    o = APPEND(o, "  mov qword ptr [rbp - 9008], rax");
    o = APPEND(o, "  mov rdi, rcx");
    o = APPEND(o, "  call null_array_new");
    o = APPEND(o, "  mov qword ptr [rbp - 9016], rax");
    o = APPEND(o, "  mov qword ptr [rbp - 9024], 0");
    o = APPEND(o, "  mov qword ptr [rbp - 9032], 0");
    o = APPEND(o, "  jmp .Lcomp_loop_" + TO_STRING(LEN(o)));
    let id = TO_STRING(LEN(o));
    let loop_lbl = ".Lcomp_loop_" + id;
    let next_lbl = ".Lcomp_next_" + id;
    let done_lbl = ".Lcomp_done_" + id;
    o = APPEND(o, "  mov rax, qword ptr [rbp - 9032]");
    o = APPEND(o, "  cmp rax, qword ptr [rbp - 9000]");
    o = APPEND(o, "  jge " + done_lbl);
    o = APPEND(o, "  mov rcx, qword ptr [rbp - 9008]");
    o = APPEND(o, "  mov rdx, qword ptr [rcx + rax * 8 + 8]");
    o = APPEND(o, "  mov qword ptr [rbp - " + TO_STRING(vofs) + "], rdx");
    o = emit_tree(o, expr_tree, 9056, vofs);
    if tree_status(pred_tree) == "ok" {
        o = emit_tree(o, pred_tree, 9120, vofs);
        o = APPEND(o, "  cmp qword ptr [rbp - 9120], 0");
        o = APPEND(o, "  je " + next_lbl);
    }
    o = APPEND(o, "  mov rax, qword ptr [rbp - 9024]");
    o = APPEND(o, "  mov rcx, qword ptr [rbp - 9016]");
    o = APPEND(o, "  mov rdx, qword ptr [rbp - 9056]");
    o = APPEND(o, "  mov qword ptr [rcx + rax * 8 + 8], rdx");
    o = APPEND(o, "  inc qword ptr [rbp - 9024]");
    o = APPEND(o, next_lbl + ":");
    o = APPEND(o, "  inc qword ptr [rbp - 9032]");
    o = APPEND(o, "  jmp " + loop_lbl);
    o = APPEND(o, done_lbl + ":");
    o = APPEND(o, "  mov rax, qword ptr [rbp - 9016]");
    o = APPEND(o, "  mov rcx, qword ptr [rbp - 9024]");
    o = APPEND(o, "  mov qword ptr [rax], rcx");
    o = APPEND(o, "  bts rax, 63");
    o = APPEND(o, "  mov qword ptr [rbp - " + TO_STRING(src) + "], rax");
    // The report list is rebuilt by the caller from its own copy, so the note
    // is written by compile() itself.
    return o;
}

fn main() -> Num {
    // argv[1] is the IR to lower (default bootstrap/program.ir), argv[2] is the
    // assembly output (default bootstrap/program.s). This lets a native driver
    // chain stages without the fixed working-directory layout.
    let ir_path = "bootstrap/program.ir";
    if ARGC() > 1 {
        ir_path = ARGV(1);
    }
    let asm_path = "bootstrap/program.s";
    if ARGC() > 2 {
        asm_path = ARGV(2);
    }
    let text = READ_FILE(ir_path);
    let rows = parse_rows(text);
    let result = compile(rows);
    let out = result[0];
    let report = result[1];
    let asm = JOIN(out, "\n") + "\n";
    WRITE_FILE(asm_path, asm);
    WRITE_FILE("bootstrap/backend.report", JOIN(report, "\n") + "\n");
    println("ASM " + TO_STRING(LEN(out)));
    println("LOWERED " + TO_STRING(count_prefix(report, "LOWERED")));
    println("FALLBACK " + TO_STRING(count_prefix(report, "FALLBACK")));
    return 0;
}

fn count_prefix(list, prefix: Text) -> Num {
    let n = 0;
    let i = 0;
    while i < LEN(list) {
        if starts_with(list[i], prefix) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

fn starts_with(text: Text, prefix: Text) -> Bool {
    if LEN(prefix) > LEN(text) {
        return false;
    }
    let ok = true;
    let i = 0;
    while i < LEN(prefix) {
        if CHAR_AT(text, i) != CHAR_AT(prefix, i) {
            ok = false;
        }
        i = i + 1;
    }
    return ok;
}

// --- driver: source file -> IR -> assembly -> native executable ---
//
// argv[1] source .null   argv[2] output executable
// argv[3] optional: 'ir-only' stops after writing the IR next to the output.
//
// Everything below is Null: the only external program is the system C
// compiler, invoked through SHELL to assemble the generated text.
let source_path = "";
let output_path = "";
let mode = "";
if ARGC() < 3 {
    println("usage: nulldriver <source.null> <output> [ir-only]");
} else {
source_path = ARGV(1);
output_path = ARGV(2);
if ARGC() > 3 {
    mode = ARGV(3);
}
let source = READ_FILE(source_path);
let ir = compile_to_ir_text(source);
WRITE_FILE(output_path + ".ir", ir);
if mode != "ir-only" {
    let rows = parse_rows(ir);
    let result = compile(rows);
    let asm = JOIN(result[0], "\n") + "\n";
    WRITE_FILE(output_path + ".s", asm);
    let report = result[1];
    WRITE_FILE(output_path + ".report", JOIN(report, "\n") + "\n");
    let fallbacks = count_prefix(report, "FALLBACK");
    println("LOWERED " + TO_STRING(count_prefix(report, "LOWERED")) + " FALLBACK " + TO_STRING(fallbacks));
    if fallbacks > 0 {
        println("nulldriver: the backend could not lower this program");
    } else {
        let status = SHELL("cc -O0 -o " + output_path + " " + output_path + ".s");
        if status != 0 {
            println("nulldriver: cc exited " + TO_STRING(status));
        } else {
            println("built " + output_path);
        }
    }
}
}