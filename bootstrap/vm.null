// ---------------------------------------------------------------------------
// Stage 4: the bootstrap VM (Null side).
//
// Reads the TSV super-bit stream written by bootstrap/emitter.null and executes
// it.  This is a *bootstrap* machine: it proves the pipeline end to end
// (source -> AST -> IR -> execution) in Null.  It is deliberately simple -
// every optimisation lives in the native backend, not here.
//
// Stream format:  IR \t opcode \t operand \t layer [\t meta]
//                 LABEL \t name
// ---------------------------------------------------------------------------

fn drop_last(list) -> Array {
    let out = [];
    let i = 0;
    while i < LEN(list) - 1 {
        out = APPEND(out, list[i]);
        i = i + 1;
    }
    return out;
}

fn replace_at(list, k: Num, value) -> Array {
    let out = [];
    let i = 0;
    while i < LEN(list) {
        if i == k {
            out = APPEND(out, value);
        } else {
            out = APPEND(out, list[i]);
        }
        i = i + 1;
    }
    return out;
}

// NB: `return` inside a loop is not reliable on the host VM, so helpers exits
// through a flag and a single trailing return.
fn index_of(list, value) -> Num {
    // LEN(list) is the "absent" sentinel: unary minus is not lowered by the
    // host front end, so -1 literals cannot be used here.
    let found = LEN(list);
    let i = 0;
    while i < LEN(list) {
        if list[i] == value {
            found = i;
            break;
        }
        i = i + 1;
    }
    return found;
}

// NB: the host front end does not lower && / ||, so conditions are nested.
// Named vm_is_digit, not is_digit: bootstrap/emitter.null has an is_digit over
// char codes, and both files are linked into bootstrap/nullc.null.
fn vm_is_digit(c: Text) -> Bool {
    if c < "0" {
        return false;
    }
    if c > "9" {
        return false;
    }
    return true;
}

fn looks_numeric(text: Text) -> Bool {
    if LEN(text) == 0 {
        return false;
    }
    let ok = true;
    let digits = 0;
    let i = 0;
    while i < LEN(text) {
        let c = CHAR_AT(text, i);
        if vm_is_digit(c) {
            digits = digits + 1;
        } else {
            if c != "." {
                if c != "-" {
                    ok = false;
                }
            }
        }
        i = i + 1;
    }
    if digits == 0 {
        ok = false;
    }
    return ok;
}

// Decode the string-literal escapes the emitter writes (see ir_escape there).
fn ir_unescape(text: Text) -> Text {
    let out = "";
    let i = 0;
    while i < LEN(text) {
        let ch = CHAR_AT(text, i);
        if ch == "\\" {
            i = i + 1;
            if i < LEN(text) {
                let esc = CHAR_AT(text, i);
                if esc == "n" {
                    out = out + "\n";
                } else {
                    if esc == "t" {
                        out = out + "\t";
                    } else {
                        out = out + esc;
                    }
                }
            }
        } else {
            out = out + ch;
        }
        i = i + 1;
    }
    return out;
}

fn const_value(text: Text) {
    // `true`/`false` reach here only as strings: bool literals are tagged in
    // the IR (see the op-1 handler), so a string literal "true" stays a string.
    if text == "NOTHING" {
        return "NOTHING";
    }
    if looks_numeric(text) {
        return TO_NUMBER(text);
    }
    return ir_unescape(text);
}

// meta is a space separated list of "key=value" entries.
fn meta_value(meta: Text, key: Text) -> Text {
    let parts = SPLIT(meta, " ");
    let found = "";
    let i = 0;
    while i < LEN(parts) {
        let kv = SPLIT(parts[i], "=");
        if LEN(kv) > 1 {
            if kv[0] == key {
                found = kv[1];
            }
        }
        i = i + 1;
    }
    return found;
}

fn has_meta(meta: Text, key: Text) -> Bool {
    let parts = SPLIT(meta, " ");
    let found = false;
    let i = 0;
    while i < LEN(parts) {
        if parts[i] == key {
            found = true;
        }
        i = i + 1;
    }
    return found;
}

fn idiv(a: Num, b: Num) -> Num {
    let q = 0;
    let rest = a;
    while rest >= b {
        rest = rest - b;
        q = q + 1;
    }
    return q;
}

fn imod(a: Num, b: Num) -> Num {
    return a - b * idiv(a, b);
}

fn parse_rows(text: Text) -> Array {
    let lines = SPLIT(text, "\n");
    let rows = [];
    let i = 0;
    while i < LEN(lines) {
        let line = lines[i];
        if LEN(line) > 0 {
            let f = SPLIT(line, "\t");
            if f[0] == "LABEL" {
                rows = APPEND(rows, ["LABEL", f[1]]);
            } else {
                if f[0] == "IR" {
                    let meta = "";
                    if LEN(f) > 4 {
                        meta = f[4];
                    }
                    rows = APPEND(rows, ["IR", TO_NUMBER(f[1]), f[2], f[3], meta]);
                }
            }
        }
        i = i + 1;
    }
    return rows;
}

fn run(rows) {
    // Pre-pass: labels and function ranges.
    let label_names = [];
    let label_ips = [];
    let fn_names = [];
    let fn_ips = [];
    let fn_ends = [];
    let fn_params = [];
    let i = 0;
    while i < LEN(rows) {
        let row = rows[i];
        if row[0] == "LABEL" {
            label_names = APPEND(label_names, row[1]);
            label_ips = APPEND(label_ips, i);
        }
        if row[0] == "IR" {
            if row[1] == 74 {
                fn_names = APPEND(fn_names, row[2]);
                fn_ips = APPEND(fn_ips, i + 1);
                fn_params = APPEND(fn_params, meta_value(row[4], "params"));
                let j = i + 1;
                while j < LEN(rows) {
                    if rows[j][0] == "IR" {
                        if rows[j][1] == 255 {
                            if rows[j][2] == "end_fn" {
                                break;
                            }
                        }
                    }
                    j = j + 1;
                }
                fn_ends = APPEND(fn_ends, j);
            }
        }
        i = i + 1;
    }

    let stack = [];
    let names = [];
    let vals = [];
    let call_stack = [];
    let ip = 0;
    let running = true;

    while running {
        let row = rows[ip];
        let next = ip + 1;
        let handled = false;

        if row[0] == "IR" {
            let op = row[1];
            let operand = row[2];
            let meta = row[4];

            if op == 1 {
                handled = true;
                if has_meta(meta, "bool") {
                    stack = APPEND(stack, operand == "true");
                } else {
                    if has_meta(meta, "str") {
                        stack = APPEND(stack, ir_unescape(operand));
                    } else {
                        stack = APPEND(stack, const_value(operand));
                    }
                }
            }
            if op == 2 {
                handled = true;
                let k = index_of(names, operand);
                if k == LEN(names) {
                    stack = APPEND(stack, 0);
                } else {
                    stack = APPEND(stack, vals[k]);
                }
            }
            if op == 3 {
                handled = true;
                let value = stack[LEN(stack) - 1];
                stack = drop_last(stack);
                let k = index_of(names, operand);
                if k == LEN(names) {
                    names = APPEND(names, operand);
                    vals = APPEND(vals, value);
                } else {
                    vals = replace_at(vals, k, value);
                }
            }
            if op == 10 {
                handled = true;
                let right = stack[LEN(stack) - 1];
                stack = drop_last(stack);
                let left = stack[LEN(stack) - 1];
                stack = drop_last(stack);
                stack = APPEND(stack, left + right);
            }
            if op == 11 {
                handled = true;
                let right = stack[LEN(stack) - 1];
                stack = drop_last(stack);
                let left = stack[LEN(stack) - 1];
                stack = drop_last(stack);
                stack = APPEND(stack, left - right);
            }
            if op == 12 {
                handled = true;
                let right = stack[LEN(stack) - 1];
                stack = drop_last(stack);
                let left = stack[LEN(stack) - 1];
                stack = drop_last(stack);
                stack = APPEND(stack, left * right);
            }
            if op == 13 {
                handled = true;
                let right = stack[LEN(stack) - 1];
                stack = drop_last(stack);
                let left = stack[LEN(stack) - 1];
                stack = drop_last(stack);
                stack = APPEND(stack, left / right);
            }
            let is_compare = false;
            if op >= 20 {
                if op <= 25 {
                    is_compare = true;
                }
            }
            if is_compare {
                handled = true;
                let right = stack[LEN(stack) - 1];
                stack = drop_last(stack);
                let left = stack[LEN(stack) - 1];
                stack = drop_last(stack);
                let result = false;
                if op == 20 {
                    result = left > right;
                }
                if op == 21 {
                    result = left < right;
                }
                if op == 22 {
                    result = left == right;
                }
                if op == 23 {
                    result = left != right;
                }
                if op == 24 {
                    result = left >= right;
                }
                if op == 25 {
                    result = left <= right;
                }
                stack = APPEND(stack, result);
            }
            if op == 30 {
                handled = true;
                let value = stack[LEN(stack) - 1];
                stack = drop_last(stack);
                println(TO_STRING(value));
            }
            if op == 40 {
                handled = true;
                let cond = stack[LEN(stack) - 1];
                stack = drop_last(stack);
                if cond == false {
                    let k = index_of(label_names, operand);
                    if k < LEN(label_names) {
                        next = label_ips[k];
                    }
                }
            }
            if op == 41 {
                handled = true;
                let k = index_of(label_names, operand);
                if k < LEN(label_names) {
                    next = label_ips[k];
                }
            }
            if op == 71 {
                handled = true;
                let returned = 0;
                if meta != "unit" {
                    if LEN(stack) > 0 {
                        returned = stack[LEN(stack) - 1];
                    }
                }
                if LEN(call_stack) == 0 {
                    running = false;
                } else {
                    let frame = call_stack[LEN(call_stack) - 1];
                    call_stack = drop_last(call_stack);
                    next = frame[0];
                    names = frame[1];
                    vals = frame[2];
                    let restored = [];
                    let s = 0;
                    while s < frame[3] {
                        restored = APPEND(restored, stack[s]);
                        s = s + 1;
                    }
                    stack = APPEND(restored, returned);
                }
            }
            if op == 72 {
                handled = true;
                let arity = TO_NUMBER(meta_value(meta, "arity"));
                let items = [];
                let a = 0;
                while a < arity {
                    items = APPEND(items, stack[LEN(stack) - 1 - a]);
                    a = a + 1;
                }
                let ordered = [];
                let b = LEN(items) - 1;
                while b >= 0 {
                    ordered = APPEND(ordered, items[b]);
                    b = b - 1;
                }
                let cut = 0;
                while cut < arity {
                    stack = drop_last(stack);
                    cut = cut + 1;
                }
                stack = APPEND(stack, ordered);
            }
            if op == 73 {
                handled = true;
                let idx = stack[LEN(stack) - 1];
                stack = drop_last(stack);
                let target = stack[LEN(stack) - 1];
                stack = drop_last(stack);
                stack = APPEND(stack, target[idx]);
            }
            if op == 106 {
                // FAST_ARRAY_PUSH: append and leave the (grown) array on top.
                handled = true;
                let value = stack[LEN(stack) - 1];
                stack = drop_last(stack);
                let arr = stack[LEN(stack) - 1];
                stack = drop_last(stack);
                let grown = APPEND(arr, value);
                stack = APPEND(stack, grown);
            }
            if op == 70 {
                handled = true;
                // Source-level calls arrive as written (LEN, TO_STRING, ...);
                // normalise the builtin names we implement here.
                let name = operand;
                if name == "LEN" {
                    name = "len";
                }
                if name == "MOD" {
                    name = "mod";
                }
                if name == "NEG" {
                    name = "neg";
                }
                if name == "CONCAT" {
                    name = "concat";
                }
                if name == "CHAR_AT" {
                    name = "char_at";
                }
                if name == "ORD" {
                    name = "ord";
                }
                if name == "READ_FILE" {
                    name = "read_file";
                }
                if name == "len" {
                    let v = stack[LEN(stack) - 1];
                    stack = drop_last(stack);
                    stack = APPEND(stack, LEN(v));
                }
                if name == "char_at" {
                    let idx = stack[LEN(stack) - 1];
                    stack = drop_last(stack);
                    let text = stack[LEN(stack) - 1];
                    stack = drop_last(stack);
                    stack = APPEND(stack, SUBSTR(TO_STRING(text), idx, idx + 1));
                }
                if name == "ord" {
                    let text = stack[LEN(stack) - 1];
                    stack = drop_last(stack);
                    stack = APPEND(stack, ORD(TO_STRING(text)));
                }
                if name == "read_file" {
                    let path = stack[LEN(stack) - 1];
                    stack = drop_last(stack);
                    stack = APPEND(stack, READ_FILE(TO_STRING(path)));
                }
                if name == "mod" {
                    let b = stack[LEN(stack) - 1];
                    stack = drop_last(stack);
                    let a = stack[LEN(stack) - 1];
                    stack = drop_last(stack);
                    stack = APPEND(stack, imod(a, b));
                }
                if name == "neg" {
                    let v = stack[LEN(stack) - 1];
                    stack = drop_last(stack);
                    stack = APPEND(stack, 0 - v);
                }
                if name == "concat" {
                    let arity = TO_NUMBER(meta_value(meta, "arity"));
                    let parts = [];
                    let a = 0;
                    while a < arity {
                        parts = APPEND(parts, stack[LEN(stack) - 1 - a]);
                        a = a + 1;
                    }
                    let acc = "";
                    let b = LEN(parts) - 1;
                    while b >= 0 {
                        acc = acc + TO_STRING(parts[b]);
                        b = b - 1;
                    }
                    let cut = 0;
                    while cut < arity {
                        stack = drop_last(stack);
                        cut = cut + 1;
                    }
                    stack = APPEND(stack, acc);
                }
                if name == "__range__" {
                    let hi = stack[LEN(stack) - 1];
                    stack = drop_last(stack);
                    let lo = stack[LEN(stack) - 1];
                    stack = drop_last(stack);
                    let items = [];
                    let v = lo;
                    while v < hi {
                        items = APPEND(items, v);
                        v = v + 1;
                    }
                    stack = APPEND(stack, items);
                }
                if name == "set_index" {
                    // arr[idx] = value: bounds-checked, then rebuilt because the
                    // host arrays this VM manipulates are immutable lists.
                    let value = stack[LEN(stack) - 1];
                    stack = drop_last(stack);
                    let idx = stack[LEN(stack) - 1];
                    stack = drop_last(stack);
                    let target = stack[LEN(stack) - 1];
                    stack = drop_last(stack);
                    if idx < 0 {
                        println("VM ERROR: index out of range " + TO_STRING(idx));
                        running = false;
                    } else {
                        if idx >= LEN(target) {
                            println("VM ERROR: index out of range " + TO_STRING(idx));
                            running = false;
                        } else {
                            let updated = replace_at(target, idx, value);
                            stack = APPEND(stack, updated);
                        }
                    }
                }
                let is_builtin = false;
                if name == "set_index" {
                    is_builtin = true;
                }
                if name == "len" {
                    is_builtin = true;
                }
                if name == "mod" {
                    is_builtin = true;
                }
                if name == "neg" {
                    is_builtin = true;
                }
                if name == "concat" {
                    is_builtin = true;
                }
                if name == "char_at" {
                    is_builtin = true;
                }
                if name == "ord" {
                    is_builtin = true;
                }
                if name == "read_file" {
                    is_builtin = true;
                }
                if name == "__range__" {
                    is_builtin = true;
                }
                if is_builtin == false {
                    let k = index_of(fn_names, operand);
                    if k == LEN(fn_names) {
                        println("VM ERROR: unknown call " + operand);
                        running = false;
                    } else {
                        let arity = TO_NUMBER(meta_value(meta, "arity"));
                        let args = [];
                        let a = 0;
                        while a < arity {
                            args = APPEND(args, stack[LEN(stack) - 1 - a]);
                            a = a + 1;
                        }
                        let ordered = [];
                        let b = LEN(args) - 1;
                        while b >= 0 {
                            ordered = APPEND(ordered, args[b]);
                            b = b - 1;
                        }
                        let cut = 0;
                        while cut < arity {
                            stack = drop_last(stack);
                            cut = cut + 1;
                        }
                        call_stack = APPEND(call_stack, [next, names, vals, LEN(stack)]);
                        names = [];
                        vals = [];
                        let params = SPLIT(fn_params[k], ",");
                        let limit = LEN(ordered);
                        if LEN(params) < limit {
                            limit = LEN(params);
                        }
                        let pi = 0;
                        while pi < limit {
                            names = APPEND(names, params[pi]);
                            vals = APPEND(vals, ordered[pi]);
                            pi = pi + 1;
                        }
                        next = fn_ips[k];
                    }
                }
            }
            if op == 74 {
                handled = true;
                let k = index_of(fn_names, operand);
                if k < LEN(fn_names) {
                    next = fn_ends[k] + 1;
                }
            }
            let is_guard = false;
            if op == 60 {
                is_guard = true;
            }
            if op == 61 {
                is_guard = true;
            }
            if op == 62 {
                is_guard = true;
            }
            if is_guard {
                // Null-safety guards keep the value already on the stack.
                handled = true;
            }
            if op == 255 {
                handled = true;
                if operand == "HALT" {
                    running = false;
                }
            }
            if handled == false {
                println("VM ERROR: unsupported opcode " + TO_STRING(op) + " " + operand);
                running = false;
            }
        }
        ip = next;
    }
}

run(parse_rows(READ_FILE("bootstrap/program.ir")));
