// bootstrap/link_driver.null
// Link step for the native executable driver.
//
// Produces bootstrap/nulldriver.null: the emitter (lexer + parser + IR
// lowering), the x86-64 backend, and a driver that turns a Null source file
// into a native executable in one process. No Python, no stage_runner.py.
//
// Usage: env PYTHONPATH=src venv/bin/python bench/stage_runner.py bootstrap/link_driver.null

fn starts_with(text: Text, prefix: Text) -> Bool {
    if LEN(text) < LEN(prefix) {
        return false;
    }
    let ok = true;
    let i = 0;
    while i < LEN(prefix) {
        if CHAR_AT(text, i) != CHAR_AT(prefix, i) {
            ok = false;
        }
        i = i + 1;
    }
    return ok;
}

fn fn_name(line: Text) -> Text {
    let rest = SUBSTR(line, 3, LEN(line));
    let name = "";
    let i = 0;
    while i < LEN(rest) {
        let ch = CHAR_AT(rest, i);
        if ch == "(" {
            break;
        }
        if ch != " " {
            name = name + ch;
        }
        i = i + 1;
    }
    return name;
}

fn has_name(names, name: Text) -> Bool {
    let found = false;
    let i = 0;
    while i < LEN(names) {
        if names[i] == name {
            found = true;
        }
        i = i + 1;
    }
    return found;
}

fn gather(path: Text, out, names) {
    let lines = SPLIT(READ_FILE(path), "\n");
    let i = 0;
    while i < LEN(lines) {
        let line = lines[i];
        if starts_with(line, "fn ") {
            let name = fn_name(line);
            let block = [line];
            i = i + 1;
            while i < LEN(lines) {
                block = APPEND(block, lines[i]);
                if lines[i] == "}" {
                    break;
                }
                i = i + 1;
            }
            i = i + 1;
            if has_name(names, name) == false {
                names = APPEND(names, name);
                let b = 0;
                while b < LEN(block) {
                    out = APPEND(out, block[b]);
                    b = b + 1;
                }
                out = APPEND(out, "");
            } else {
                println("LINK skip duplicate " + name);
            }
        } else {
            i = i + 1;
        }
    }
    return [out, names];
}

let out = [
    "// ---------------------------------------------------------------------------",
    "// GENERATED by bootstrap/link_driver.null - do not edit.",
    "// Sources: bootstrap/emitter.null (lexer, parser, IR) and",
    "// bootstrap/native.null (x86-64 backend), plus the driver below.",
    "// One Null binary: source -> IR -> assembly -> executable.",
    "// ---------------------------------------------------------------------------",
    "",
];
let names = [];
let parts = ["bootstrap/emitter.null", "bootstrap/native.null"];
let p = 0;
while p < LEN(parts) {
    let got = gather(parts[p], out, names);
    out = got[0];
    names = got[1];
    p = p + 1;
}

out = APPEND(out, "// --- driver: source file -> IR -> assembly -> native executable ---");
out = APPEND(out, "//");
out = APPEND(out, "// argv[1] source .null   argv[2] output executable");
out = APPEND(out, "// argv[3] optional: 'ir-only' stops after writing the IR next to the output.");
out = APPEND(out, "//");
out = APPEND(out, "// Everything below is Null: the only external program is the system C");
out = APPEND(out, "// compiler, invoked through SHELL to assemble the generated text.");
out = APPEND(out, "let source_path = \"\";");
out = APPEND(out, "let output_path = \"\";");
out = APPEND(out, "let mode = \"\";");
out = APPEND(out, "if ARGC() < 3 {");
out = APPEND(out, "    println(\"usage: nulldriver <source.null> <output> [ir-only]\");");
out = APPEND(out, "} else {");
out = APPEND(out, "source_path = ARGV(1);");
out = APPEND(out, "output_path = ARGV(2);");
out = APPEND(out, "if ARGC() > 3 {");
out = APPEND(out, "    mode = ARGV(3);");
out = APPEND(out, "}");
out = APPEND(out, "let source = READ_FILE(source_path);");
out = APPEND(out, "let ir = compile_to_ir_text(source);");
out = APPEND(out, "WRITE_FILE(output_path + \".ir\", ir);");
out = APPEND(out, "if mode != \"ir-only\" {");
out = APPEND(out, "    let rows = parse_rows(ir);");
out = APPEND(out, "    let result = compile(rows);");
out = APPEND(out, "    let asm = JOIN(result[0], \"\\n\") + \"\\n\";");
out = APPEND(out, "    WRITE_FILE(output_path + \".s\", asm);");
out = APPEND(out, "    let report = result[1];");
out = APPEND(out, "    WRITE_FILE(output_path + \".report\", JOIN(report, \"\\n\") + \"\\n\");");
out = APPEND(out, "    let fallbacks = count_prefix(report, \"FALLBACK\");");
out = APPEND(out, "    println(\"LOWERED \" + TO_STRING(count_prefix(report, \"LOWERED\")) + \" FALLBACK \" + TO_STRING(fallbacks));");
out = APPEND(out, "    if fallbacks > 0 {");
out = APPEND(out, "        println(\"nulldriver: the backend could not lower this program\");");
out = APPEND(out, "    } else {");
out = APPEND(out, "        let status = SHELL(\"cc -O0 -o \" + output_path + \" \" + output_path + \".s\");");
out = APPEND(out, "        if status != 0 {");
out = APPEND(out, "            println(\"nulldriver: cc exited \" + TO_STRING(status));");
out = APPEND(out, "        } else {");
out = APPEND(out, "            println(\"built \" + output_path);");
out = APPEND(out, "        }");
out = APPEND(out, "    }");
out = APPEND(out, "}");
out = APPEND(out, "}");

WRITE_FILE("bootstrap/nulldriver.null", JOIN(out, "\n"));
println("LINKED " + TO_STRING(LEN(names)) + " functions -> bootstrap/nulldriver.null");
