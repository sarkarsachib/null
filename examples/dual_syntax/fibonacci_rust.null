// Fibonacci in Rust-like syntax
// Demonstrates: function definitions, for loops, variables

fn fibonacci(n: i32) -> i32 {
    let mut a = 0;
    let mut b = 1;
    
    for i in 0..n {
        let temp = a + b;
        a = b;
        b = temp;
    }
    
    return a;
}

fn main() {
    let result = fibonacci(10);
    println("Fibonacci(10) = ");
}
