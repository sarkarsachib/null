// Null-Lang Grammar Definition
// English-like syntax for the Null-Lang programming language

?start: program

program: module_header? import_section? statement*

module_header: "module" module_name

import_section: import_statement+

import_statement: annotation* "import" module_name ("as" identifier)?

module_name: NAME ("::" NAME)*

?statement: annotated_statement
          | comment

annotated_statement: annotation* base_statement -> attach_annotations

?base_statement: type_alias_statement
                | data_class_statement
                | sealed_trait_statement
                | let_binding_statement
                | set_statement
                | add_statement
                | if_statement
                | show_statement
                | input_statement
                | read_file_statement
                | write_file_statement
                | file_exists_statement
                | list_files_statement
                | repeat_statement
                | define_statement
                | return_statement
                | expression_statement

// Annotations

annotation: layer_annotation
          | require_annotation
          | prefer_annotation

layer_annotation: "@" "layer" "(" identifier ")" -> make_layer_annotation

require_annotation: "@" "require" "(" identifier_list ")" -> make_require_annotation

prefer_annotation: "@" "prefer" "(" identifier_list ")" -> make_prefer_annotation

identifier_list: identifier ("," identifier)*

// Type System

type_alias_statement: "type" identifier "=" type_annotation -> make_type_alias

data_class_statement: "class" "data" identifier "{" field_list "}" -> make_data_class

sealed_trait_statement: "sealed" "trait" identifier generic_params? "{" variant_list "}" -> make_sealed_trait

let_binding_statement: "let" identifier (":" type_annotation)? ("=" expression)? -> make_let_binding

type_annotation: identifier generic_params? ("?")? -> parse_type_annotation

generic_params: "<" identifier ("," identifier)* ">"

field_list: field_decl ("," field_decl)*

field_decl: identifier ":" type_annotation

variant_list: variant_decl ("," variant_decl)*

variant_decl: identifier ("(" type_annotation ")")?

// Commands

set_statement: "SET" target "TO" expression -> set_cmd
target: identifier
      | member_access

add_statement: "ADD" comparison_expression ("AND" comparison_expression)+ -> add_cmd

if_statement: "IF" expression "THEN" block ("ELSE" block)? "END" "IF" -> if_cmd

show_statement: "SHOW" expression -> show_cmd

input_statement: "INPUT" identifier ("(" expression ")")? -> input_cmd

read_file_statement: "SET" identifier "TO" "READ_FILE" expression -> read_file_cmd

write_file_statement: "WRITE_FILE" expression "WITH" expression -> write_file_cmd

file_exists_statement: "SET" identifier "TO" "FILE_EXISTS" expression -> file_exists_cmd

list_files_statement: "SET" identifier "TO" "LIST_FILES" expression -> list_files_cmd

repeat_statement: "REPEAT" atom "TIMES" block "END" "REPEAT" -> repeat_cmd

define_statement: "DEFINE" identifier ("WITH" parameter_list)? block "END" "DEFINE" -> define_cmd

return_statement: "RETURN" expression -> return_cmd

expression_statement: expression

block: statement+

parameter_list: identifier ("," identifier)*

// Expressions

?expression: or_expression

?or_expression: and_expression
              | or_expression "OR" and_expression

?and_expression: comparison_expression
               | and_expression "AND" comparison_expression

?comparison_expression: arithmetic_expression
                      | arithmetic_expression comparison_op arithmetic_expression

?arithmetic_expression: not_expression
                       | arithmetic_expression "PLUS" not_expression -> add_expr
                       | arithmetic_expression "+" not_expression -> add_expr
                       | arithmetic_expression "MINUS" not_expression -> subtract_expr
                       | arithmetic_expression "-" not_expression -> subtract_expr

?not_expression: term
               | "NOT" term -> not_expr

comparison_op: "IS" "NOT" -> is_not
             | "IS" "GREATER" "THAN" -> is_greater
             | "IS" "LESS" "THAN" -> is_less
             | "IS" "GREATER" "OR" "EQUAL" "TO" -> is_greater_equal
             | "IS" "LESS" "OR" "EQUAL" "TO" -> is_less_equal
             | "IS" -> is_equal
             | "EQUALS" -> equals
             | "NOT" "EQUALS" -> not_equals
             | "==" -> is_equal
             | "!=" -> not_equals
             | ">" -> is_greater
             | "<" -> is_less
             | ">=" -> is_greater_equal
             | "<=" -> is_less_equal

?term: factor
     | term "TIMES" factor -> multiply_expr
     | term "*" factor -> multiply_expr
     | term "DIVIDED" "BY" factor -> divide_expr
     | term "/" factor -> divide_expr

?factor: atom
       | "MINUS" factor -> negate_expr
       | "-" factor -> negate_expr

?atom: literal
     | safe_call_expr
     | elvis_expr
     | not_null_expr
     | member_access
     | function_call
     | legacy_null_lib_annotation
     | qualified_name
     | identifier
     | "(" expression ")"

safe_call_expr: atom "?" "." identifier -> safe_call_property
              | atom "?" "[" expression "]" -> safe_call_index
              | atom "?" "(" (argument_list)? ")" -> safe_call_method

elvis_expr: atom "?" ":" atom -> make_elvis

not_null_expr: atom "!" "!" -> make_not_null

// Literals

literal: text_literal
       | num_literal
       | bool_literal
       | array_literal
       | object_literal

text_literal: ESCAPED_STRING

num_literal: NUMBER

bool_literal: "TRUE" -> true_literal
            | "FALSE" -> false_literal

array_literal: "ARRAY" "[" (expression ("," expression)*)? "]"
             | "[" (expression ("," expression)*)? "]"

object_literal: "OBJECT" "{" (object_pair ("," object_pair)*)? "}"
              | "{" (object_pair ("," object_pair)*)? "}"

object_pair: (identifier | ESCAPED_STRING) ":" expression

// Member Access

member_access: atom "." identifier -> property_access
             | atom "[" expression "]" -> index_access

// Function Calls

function_call: "CALL" qualified_name ("WITH" argument_list)? -> call_func
             | "CALL" identifier ("WITH" argument_list)? -> call_func
             | qualified_name "(" (argument_list)? ")" -> call_func_parens
             | identifier "(" (argument_list)? ")" -> call_func_parens

argument_list: expression ("," expression)*

// Legacy Null-Lib Annotations (inline library calls)

legacy_null_lib_annotation: "@" identifier "." identifier ("(" (argument_list)? ")")? -> null_lib_call

// Identifiers

qualified_name.2: NAME ("::" NAME)+

identifier.1: NAME

// Comments

comment: COMMENT

// Terminals

NAME: /[a-zA-Z_][a-zA-Z0-9_]*/
NUMBER: /[0-9]+(\.[0-9]+)?/
ESCAPED_STRING: /"([^"\\]|\\.)*"/
                | /'([^'\\]|\\.)*'/

COMMENT: /#[^\n]*/

// Whitespace
%import common.WS
%ignore WS
%ignore COMMENT
