{
  "scopeName": "source.null",
  "fileTypes": ["null"],
  "name": "Null-Lang",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#variables"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.hash.null",
          "match": "#.*$",
          "comment": "Line comment"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.null",
          "match": "\\b(SET|TO|IF|THEN|ELSE|REPEAT|TIMES|DEFINE|WITH|DOES|AND|OR|NOT|IS|EQUALS|GREATER|LESS|THAN)\\b"
        },
        {
          "name": "keyword.other.null",
          "match": "\\b(SHOW|ADD|SUBTRACT|MULTIPLY|DIVIDE|TRUE|FALSE)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.null",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.null",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.null",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.null",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.null",
          "match": "-?\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.null",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.null",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
