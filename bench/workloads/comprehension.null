// Fused comprehension workload: total = sum(x*x for even x in 1..20M).
// Baseline: bench/c/comprehension.c (cc -O3 -march=native).
// The fused lowering (FUSED_COMPREHEND = 113) lives in bench/ir/comprehension.ir.
let n = 20000000;
let total = 0;
let x = 1;
while x <= n {
    if x - (x / 2) * 2 == 0 {
        total = total + x * x;
    }
    x = x + 1;
}
println(total);
